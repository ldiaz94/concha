(* Cinterp: the tree-walking evaluator, and process control.

   Every statement marks the arena as it starts and releases it as it
   ends, so the temporaries an expression makes die with the statement
   that made them; a loop releases what its condition made after each
   test. A variable owns its value (Cvars). An error is an ERROR passed
   on with try to whoever deals with it; break, continue and exit are
   not errors, and travel as a flag, ctl, which each list of statements
   and each loop looks at.

   A command's words are expanded, then it runs: a procedure or a
   builtin in the shell, with its redirections made and undone around
   it; anything else in a child, which joins the job's process group
   under job control. A signal the shell takes is only noted when it
   comes (Sys.handle), and seen where the shell looks for it: before
   each statement, and wherever a system call it interrupts gave up.

   Depends on Ccore for values and errors, on Csyntax for the tree, on
   Cvars for the variables and procedures, on Cglob for patterns, on
   Cclock for time(), and on Ccomplete and Cedit for completion and
   "did you mean". Left out: the command line and the REPL, which are
   Concha's. *)
module Cinterp;
import Sys, Rt, Mem, Files, Fmt, Buf, Str, Heap, Ccore, Csyntax, Cvars, Cglob, Cclock, Cedit, Ccomplete, Vals := Vec(Ccore.Val), Jobs := Vec(Job), Stages := Vec(Stage), Ints := Vec(INT), Names := Vec([]U8);

const
    MaxSaves = 256;    (* fds saved around a builtin's redirections *)
    MaxSubs = 64;    (* <(...)s open at once *)
    HereMax = 32768;    (* a here string the shell writes itself; a longer one, a child *)

    (* The signals trap takes: EXIT, which isn't one, and the rest *)
    TrapNames: [][]U8 = ["EXIT", "HUP", "INT", "QUIT", "TERM", "USR1", "USR2"];
    TrapSigs: []INT = [0, Sys.sigHup, Sys.sigInt, Sys.sigQuit, Sys.sigTerm, Sys.sigUsr1, Sys.sigUsr2];
    NTrap = LEN(TrapSigs);

type
    Ctl* = (cNone, cBreak, cCont, cExit);

    (* What trap set for a signal *)
    Act = (aDefault, aIgnore, aProc);
    Trap = record
        act: Act;
        name: []U8;    (* aProc's procedure, from the heap *)
        pend: BOOL;    (* come, its procedure not yet run *)
    end;

    (* What a signal of the trap table does to the shell *)
    Disp = (
        dDefault,    (* what it does at first *)
        dIgnore,
        dInt,    (* SIGINT: stops what runs *)
        dHup,    (* SIGHUP: passed on to the jobs, then the end *)
        dTrap,    (* its trap's procedure runs *)
        dPassOn    (* in a background list: passed on to the list's group *)
    );

    (* How a process ended *)
    Ended = record
        how: Sys.Status;
        n: INT;    (* exited: its status; killed or stopped: the signal *)
    end;

    (* A job: one process group, its processes in pipeline order *)
    Job = record
        id: INT;    (* the number shown as [id] *)
        pgid: INT;
        pids: []INT;    (* from the heap, as are ends and name *)
        ends: []Ended;    (* once reaped *)
        left: INT;    (* processes not yet reaped *)
        stopped: BOOL;
        hasTio: BOOL;    (* tio holds its terminal, saved as it stopped *)
        tio: Sys.Mode;
        name: []U8;
    end;

    (* A redirection with its word expanded *)
    Rx = record
        kind: Csyntax.RedirKind;
        fd, fd2: INT;
        s: []U8;    (* the file, or a here string's text *)
    end;

    (* A command's words and redirections, expanded *)
    Stage = record
        args: Vals.Vec;
        rx: []Rx;
    end;

    Save = record
        fd, saved: INT;    (* saved -1: fd was closed *)
    end;

    (* A <(...): the read end the command is given, and the list's
       process, 0 once it is reaped or left to its stopped job *)
    Sub = record
        fd, pid, pg: INT;
    end;

var
    ctl*: Ctl;    (* a break, continue or exit on its way out *)
    intr*: BOOL;    (* SIGINT came, and stops what runs *)
    interactive: BOOL;
    curFunc: ^Csyntax.Stmt;    (* the procedure running, nil outside any *)

    traps: [NTrap]Trap;
    disps: [NTrap]Disp;
    trapPending: BOOL;

    saves: [MaxSaves]Save;
    nsave: INT;
    subs: [MaxSubs]Sub;
    nsub: INT;
    (* The command being expanded, for its <(...)s: under job control
       they lead or join its job's group, subPg, if it forks. runPipe
       sets them. *)
    subPg: INT;
    subSt: ^Stage;    (* a single command's words so far *)
    subAll: BOOL;    (* a pipeline: every stage forks *)

    jobs: Jobs.Vec;    (* not yet reaped, oldest first; the last is current *)
    jc: BOOL;    (* job control: the shell owns the terminal *)
    jobChild: BOOL;    (* forked into a job's process group *)
    shellPg, origPg: INT;    (* the shell's group, and the one to give back *)
    shellTio: Sys.Mode;    (* the terminal as the shell likes it *)

    tailOk: BOOL;    (* the next command may exec over this process *)
    intSeen: BOOL;    (* waitFor let a Ctrl-C pass *)
    keepFds: BOOL;    (* exec with no command: its redirections stay *)
    exempt: INT;    (* above 0, a failure doesn't trigger errexit *)
    inPromptProc: BOOL;    (* the prompt procedure runs *)
    chainSkipped: BOOL;    (* the last pipeline of the chain didn't run *)

proc execStmt(s: ^Csyntax.Stmt): ERROR; forward;
proc execList(l: []^Csyntax.Stmt): ERROR; forward;
proc eval(e: ^Csyntax.Expr): (Ccore.Val, ERROR); forward;
proc runArgs(a: []Ccore.Val): (INT, ERROR); forward;
proc builtin(e: ^Csyntax.Expr): (Ccore.Val, ERROR); forward;
proc runText*(text, path: []U8): ERROR; forward;
proc reapJobs*; forward;
proc complete*(p: []U8; cx: Cedit.Context; words: []Ccore.Val; var out: Vals.Vec): BOOL; forward;
proc correct(a: []Ccore.Val); forward;

(* ---------------------------------------------------------- signals *)

(* What the shell's default is for trap entry i. *)
proc shellDefault(i: INT): Disp;
begin
    if TrapSigs[i] = Sys.sigInt then return dInt; end;
    if TrapSigs[i] = Sys.sigHup then return dHup; end;
    if (TrapSigs[i] = Sys.sigQuit) and interactive then return dIgnore; end;
    return dDefault;
end;

(* Trap entry i's signal made to do d. *)
proc setSig(i: INT; d: Disp);
begin
    disps[i] := d;
    match d of
    | dDefault: _ := Sys.ignore(TrapSigs[i], false);
    | dIgnore: _ := Sys.ignore(TrapSigs[i], true);
    | else: _ := Sys.handle(TrapSigs[i]);
    end;
end;

(* What trap entry i asks for, made so; its default is the shell's own. *)
proc applySig(i: INT);
begin
    match traps[i].act of
    | aProc: setSig(i, dTrap);
    | aIgnore: setSig(i, dIgnore);
    | aDefault: setSig(i, shellDefault(i));
    end;
end;

(* The terminal has gone: the hangup passed on to every job, the
   stopped ones woken to take it, then the shell's end by it. *)
proc hangUp;
var a: []Job; i: INT;
begin
    a := Jobs.all(jobs);
    for i := 0 to LEN(a) - 1 do
        _ := Sys.kill(-a[i].pgid, Sys.sigHup);
        if a[i].stopped then _ := Sys.kill(-a[i].pgid, Sys.sigCont); end;
    end;
    _ := Sys.ignore(Sys.sigHup, false);
    _ := Sys.kill(Sys.pid(), Sys.sigHup);
end;

(* The signals that came since the last look, each doing what it
   does to the shell; the REPL looks too, when a line ends. *)
proc noteSignals*;
var i, sig: INT;
begin
    for i := 1 to NTrap - 1 do
        sig := TrapSigs[i];
        if (disps[i] >= dInt) and Sys.came(sig) then
            match disps[i] of
            | dInt: intr := true;
            | dHup: hangUp;
            | dTrap:
                traps[i].pend := true;
                trapPending := true;
            | dPassOn:
                (* in a background list: meant for the whole list, so
                   passed on to its group, this shell included, which
                   then dies of it *)
                _ := Sys.ignore(sig, false);
                _ := Sys.kill(0, sig);
            | else:
            end;
        end;
    end;
end;

(* The signals as the shell takes them, and for an interactive one the
   job control stops ignored. *)
proc onSignals*;
var i: INT;
begin
    for i := 1 to NTrap - 1 do applySig(i); end;
    if interactive then
        _ := Sys.ignore(Sys.sigTstp, true);
        _ := Sys.ignore(Sys.sigTtin, true);
        _ := Sys.ignore(Sys.sigTtou, true);
    end;
end;

proc giveTerm(pg: INT);
begin
    _ := Sys.foreground(0, pg);
end;

(* The interactive shell takes the terminal: it waits to be in the
   foreground, then leads a process group of its own. *)
proc jobControl*;
var pg: INT;
begin
    _ := Sys.ignore(Sys.sigTtin, false);
    while true do
        pg := Sys.foregroundOf(0);
        if pg < 0 then return; end;
        if pg = Sys.group() then break; end;
        _ := Sys.kill(0, Sys.sigTtin);
    end;
    _ := Sys.ignore(Sys.sigTtin, true);
    origPg := pg;
    _ := Sys.setGroup(0, 0);
    shellPg := Sys.group();
    giveTerm(shellPg);
    shellTio, _ := Sys.getMode(0);
    jc := true;
end;

(* The signals of a program about to be run: those ignored stay
   ignored, the rest go back to what they do at first. *)
proc execSignals;
var i: INT;
begin
    for i := 1 to NTrap - 1 do
        if traps[i].act = aIgnore then setSig(i, dIgnore); else setSig(i, dDefault); end;
    end;
    _ := Sys.ignore(Sys.sigTstp, false);
    _ := Sys.ignore(Sys.sigTtin, false);
    _ := Sys.ignore(Sys.sigTtou, false);
end;

(* In a forked child, which doesn't run the shell's trap procedures. *)
proc childSignals;
var i: INT;
begin
    Ccore.opts^.inChild := true;
    for i := 0 to NTrap - 1 do
        if traps[i].act = aProc then traps[i].act := aDefault; end;
        traps[i].pend := false;
    end;
    trapPending := false;
    jc := false;
    execSignals;
end;

(* A new process put in the group pg, 0 a group of its own, and given
   the terminal in the foreground. Both sides of the fork do this, for
   either may run first. *)
proc joinGroup(pid, pg: INT; fg: BOOL);
begin
    if not jc then return; end;
    if pg = 0 then pg := pid; end;
    _ := Sys.setGroup(pid, pg);
    if fg then giveTerm(pg); end;
end;

(* The child's side: the job joined, then the signals reset. *)
proc childJob(pg: INT; fg: BOOL);
begin
    if jc then
        joinGroup(Sys.pid(), pg, fg);
        jobChild := true;
    end;
    childSignals;
end;

(* After SIGINT: status 130 and Stopped, or in a child its end. *)
proc interrupted: ERROR;
begin
    intr := false;
    if Ccore.opts^.inChild then Sys.exit(130); end;
    Cvars.setStatus(130);
    Ccore.put(2, "\n");
    return Ccore.Stopped;
end;

(* ------------------------------------------------------ descriptors *)

proc saveFd(fd: INT): ERROR;
begin
    if nsave >= MaxSaves then return Ccore.fail("too many redirections"); end;
    saves[nsave] := {fd: fd, saved: Sys.dupAbove(fd, 10)};
    INC(nsave);
    return nil;
end;

(* The fds saved above lvl put back. *)
proc restoreFds(lvl: INT);
begin
    while nsave > lvl do
        DEC(nsave);
        if saves[nsave].saved >= 0 then
            _ := Sys.dupTo(saves[nsave].saved, saves[nsave].fd);
            Sys.close(saves[nsave].saved);
        else
            Sys.close(saves[nsave].fd);
        end;
    end;
end;

(* The redirections above lvl made for good: the copies forgotten. *)
proc commitFds(lvl: INT);
begin
    while nsave > lvl do
        DEC(nsave);
        if saves[nsave].saved >= 0 then Sys.close(saves[nsave].saved); end;
    end;
end;

(* src moved to dst, dst saved first if save. *)
proc place(src, dst: INT; save: BOOL): ERROR;
begin
    if src = dst then return nil; end;
    if save then try saveFd(dst); end;
    _ := Sys.dupTo(src, dst);
    Sys.close(src);
    return nil;
end;

(* A pipe with s to read from it; a child writes a long one. *)
proc hereFd(s: []U8): (INT, ERROR);
var r, w: INT;
begin
    r, w := Sys.pipe();
    if r < 0 then return 0, Ccore.fail("cannot make pipe"); end;
    if LEN(s) <= HereMax then
        Ccore.put(w, s);
    elsif Sys.fork() = 0 then
        Sys.close(r);
        Ccore.put(w, s);
        Sys.exit(0);
    end;
    Sys.close(w);
    return r, nil;
end;

(* The file of x, opened as how asks; -1, having said why, if it can't
   be. *)
proc openRedir(x: Rx; how: Sys.Accesses): INT;
var fd: INT;
begin
    fd := Sys.openMode(x.s, how, Ccore.permAll);
    if fd < 0 then Ccore.warnOn(x.s, Ccore.text("cannot open: {}", [Fmt.str(Ccore.errText(-fd))])); end;
    return fd;
end;

(* The redirections rx made, each fd they change saved if save; false
   if a file can't be opened, the caller to put back what was placed. *)
proc redirect(rx: []Rx; save: BOOL): (BOOL, ERROR);
var fd, i: INT;
begin
    for i := 0 to LEN(rx) - 1 do
        match rx[i].kind of
        | rIn, rOut, rApp:
            match rx[i].kind of
            | rIn: fd := openRedir(rx[i], {Sys.reading});
            | rOut: fd := openRedir(rx[i], {Sys.writing, Sys.creating, Sys.truncating});
            | else: fd := openRedir(rx[i], {Sys.writing, Sys.creating, Sys.appending});
            end;
            if fd < 0 then return false, nil; end;
            try place(fd, rx[i].fd, save);
        | rBoth:
            fd := openRedir(rx[i], {Sys.writing, Sys.creating, Sys.truncating});
            if fd < 0 then return false, nil; end;
            try place(fd, 1, save);
            if save then try saveFd(2); end;
            _ := Sys.dupTo(1, 2);
        | rDup:
            if save then try saveFd(rx[i].fd); end;
            _ := Sys.dupTo(rx[i].fd2, rx[i].fd);
        | rHere:
            fd := try hereFd(rx[i].s);
            try place(fd, rx[i].fd, save);
        end;
    end;
    return true, nil;
end;

(* -------------------------------------------------------- processes *)

(* An end as a shell's status: the exit status, or 128 and the signal. *)
proc exitCode(e: Ended): INT;
begin
    match e.how of
    | exited: return e.n;
    | killed: return 128 + e.n;
    | else: return 1;
    end;
end;

(* Waits for a child outside job control. One that stops is continued,
   since nobody could resume it; but in a job, the job stops with it. *)
proc waitFor(pid: INT): INT;
var e: Ended; r: INT;
begin
    while true do
        r, e.how, e.n := Sys.wait(pid, true);
        if r < 0 then
            if r # -Ccore.errIntr then return 127; end;
            noteSignals;
        elsif e.how = Sys.stopped then
            if jobChild then
                _ := Sys.kill(Sys.pid(), Sys.sigStop);
            else
                Ccore.errHead;
                Ccore.put(2, "stopped; no job control here, continuing\n");
                _ := Sys.kill(pid, Sys.sigCont);
            end;
        else
            break;
        end;
    end;
    (* wait and see, as bash does: a Ctrl-C the child caught and lived
       through was the child's business, so it stops no loop here *)
    noteSignals;
    if intr then
        intSeen := true;
        intr := (e.how = Sys.killed) and (e.n = Sys.sigInt);
    end;
    return exitCode(e);
end;

(* ------------------------------------------------------------- jobs *)

(* The table is kept in age order, and a job that stops moves to the
   end: the last is the current job. Jobs move, so an index is good
   only until the table next changes. *)

(* A new job of the processes pids, in the group pg: its index. *)
proc newJob(pids: []INT; pg: INT; name: []U8): INT;
var j: ^Job; a: []Job; p: ^INT; e: ^Ended; i, id: INT; ok: BOOL;
begin
    a := Jobs.all(jobs);
    id := 1;    (* the least number not in use *)
    i := 0;
    while i < LEN(a) do
        if a[i].id = id then
            INC(id);
            i := 0;
        else
            INC(i);
        end;
    end;
    j := Jobs.add(jobs);
    j^ := {id: id, pgid: pg, left: LEN(pids)};
    p := ^INT(Mem.alloc(Heap.heap, LEN(pids) * SIZE(INT), 8));
    e := ^Ended(Mem.alloc(Heap.heap, LEN(pids) * SIZE(Ended), 8));
    if (p = nil) or (e = nil) then Rt.stop("concha: out of memory\n"); end;
    j^.pids := p[0..LEN(pids)];
    j^.ends := e[0..LEN(pids)];
    COPY(j^.pids, pids);
    for i := 0 to LEN(pids) - 1 do j^.ends[i] := {how: Sys.exited, n: 127}; end;
    j^.name, ok := Str.copy(Heap.heap, name);
    if not ok then Rt.stop("concha: out of memory\n"); end;
    return jobs.len - 1;
end;

proc stoppedJobs*: BOOL;
var a: []Job; k: INT;
begin
    a := Jobs.all(jobs);
    for k := 0 to LEN(a) - 1 do
        if a[k].stopped then return true; end;
    end;
    return false;
end;

proc dropJob(k: INT);
var a: []Job;
begin
    a := Jobs.all(jobs);
    Mem.free(Heap.heap, ^U8(ADR(a[k].pids[0])));
    Mem.free(Heap.heap, ^U8(ADR(a[k].ends[0])));
    Str.free(Heap.heap, a[k].name);
    COPY(a[k..LEN(a) - 1], a[k + 1..LEN(a)]);
    Jobs.resize(jobs, LEN(a) - 1);
end;

(* Job k moved to the end, made current: its new index. *)
proc makeCurrent(k: INT): INT;
var a: []Job; j: Job;
begin
    a := Jobs.all(jobs);
    j := a[k];
    COPY(a[k..LEN(a) - 1], a[k + 1..LEN(a)]);
    a[LEN(a) - 1] := j;
    return LEN(a) - 1;
end;

(* The end of pid noted: the job it was of, or -1. *)
proc reaped(pid: INT; e: Ended): INT;
var a: []Job; k, i: INT;
begin
    a := Jobs.all(jobs);
    for k := 0 to LEN(a) - 1 do
        for i := 0 to LEN(a[k].pids) - 1 do
            if a[k].pids[i] = pid then
                a[k].ends[i] := e;
                DEC(a[k].left);
                return k;
            end;
        end;
    end;
    return -1;
end;

proc findJob(pid: INT): INT;
var a: []Job; k, i: INT;
begin
    a := Jobs.all(jobs);
    for k := 0 to LEN(a) - 1 do
        for i := 0 to LEN(a[k].pids) - 1 do
            if a[k].pids[i] = pid then return k; end;
        end;
    end;
    return -1;
end;

(* "[id] what name" of job k, on standard error. *)
proc report(k: INT; what: []U8);
var j: ^Job; b: Buf.Buf; m: Ccore.Mark;
begin
    j := ADR(Jobs.all(jobs)[k]);
    m := Ccore.mark();
    Buf.init(b, Ccore.temps);
    Fmt.write(b, "[{}] {} {}\n", [Fmt.int(j^.id), Fmt.str(what), Fmt.str(j^.name)]);
    Ccore.put(2, Buf.bytes(b));
    Ccore.release(m);
end;

(* A finished job's status: its last process's, or with pipefail its
   last failing one's. *)
proc jobStatus(k: INT): INT;
var j: ^Job; i, st, r: INT; pf: BOOL;
begin
    j := ADR(Jobs.all(jobs)[k]);
    pf := Cvars.flag("pipefail");
    for i := 0 to LEN(j^.ends) - 1 do
        st := exitCode(j^.ends[i]);
        if not pf or (st # 0) then r := st; end;
    end;
    return r;
end;

(* Waits for the foreground job k to finish or stop, then takes the
   terminal back. A job that stops stays in the table, and the shell
   goes back to the prompt with status 148 and Stopped. *)
proc waitJob(k: INT): (INT, ERROR);
var j: ^Job; e, last: Ended; m: Sys.Mode; r, i, st: INT;
begin
    j := ADR(Jobs.all(jobs)[k]);
    while j^.left > 0 do
        r, e.how, e.n := Sys.wait(-j^.pgid, true);
        if r < 0 then
            if r # -Ccore.errIntr then break; end;
            noteSignals;
        elsif e.how = Sys.stopped then
            j^.stopped := true;
            break;
        else
            _ := reaped(r, e);
        end;
    end;
    giveTerm(shellPg);
    if j^.stopped then
        (* its <(...)s stopped with it: fg continues them, and closeSubs
           only closes their pipes *)
        for i := 0 to nsub - 1 do
            if subs[i].pg = j^.pgid then subs[i].pid := 0; end;
        end;
        j^.tio, r := Sys.getMode(0);
        j^.hasTio := r = 0;
        _ := Sys.setMode(0, shellTio);
        k := makeCurrent(k);
        Ccore.put(2, "\n");
        report(k, "stopped");
        Cvars.setStatus(148);
        return 0, Ccore.Stopped;
    end;
    (* a program killed by a signal may leave the terminal in a mess; one
       that exits may have set it up with stty on purpose *)
    last := j^.ends[LEN(j^.ends) - 1];
    if last.how = Sys.killed then
        _ := Sys.setMode(0, shellTio);
    else
        m, r := Sys.getMode(0);
        if r = 0 then shellTio := m; end;
    end;
    (* the terminal sent Ctrl-C to the job, not to the shell *)
    if (last.how = Sys.killed) and (last.n = Sys.sigInt) then intr := true; end;
    st := jobStatus(k);
    dropJob(k);
    return st, nil;
end;

(* Waits for the foreground job of the processes pids, in the group pg.
   When a <(...) leads the group, it may have read the terminal before
   the group had it, and stopped: it is continued. *)
proc foreground(pids: []INT; pg: INT; name: []U8): (INT, ERROR);
begin
    if pg # pids[0] then _ := Sys.kill(-pg, Sys.sigCont); end;
    return waitJob(newJob(pids, pg, name));
end;

(* A job's name: its words. *)
proc argsName(a: []Ccore.Val; var b: Buf.Buf);
var i: INT;
begin
    if LEN(a) = 0 then Buf.str(b, "..."); end;
    for i := 0 to LEN(a) - 1 do
        if i > 0 then Buf.add(b, ' '); end;
        Buf.str(b, Ccore.bytes(Ccore.toStr(a[i])));
    end;
end;

(* Waits for a single command in the foreground, in the group pg, 0 its
   own. *)
proc waitFg(pid, pg: INT; a: []Ccore.Val): (INT, ERROR);
var b: Buf.Buf; pids: [1]INT;
begin
    if not jc then return waitFor(pid), nil; end;
    if pg = 0 then pg := pid; end;
    joinGroup(pid, pg, true);
    Buf.init(b, Ccore.temps);
    argsName(a, b);
    pids[0] := pid;
    return foreground(pids, pg, Buf.bytes(b));
end;

proc fork: (INT, ERROR);
var pid: INT;
begin
    pid := Sys.fork();
    if pid < 0 then return 0, Ccore.fail("cannot fork"); end;
    return pid, nil;
end;

(* The environment of a program the shell runs: its exported globals,
   as NAME=value. *)
proc buildEnv: [][]U8;
var env: Names.Vec; g: []Cvars.Var; b: Buf.Buf; i: INT;
begin
    Names.init(env, Ccore.temps);
    g := Cvars.allGlobals();
    for i := 0 to LEN(g) - 1 do
        if g[i].exported then
            Buf.init(b, Ccore.temps);
            Buf.str(b, g[i].name);
            Buf.add(b, '=');
            Buf.str(b, Ccore.bytes(Ccore.toStr(g[i].v)));
            Names.push(env, Buf.bytes(b));
        end;
    end;
    return Names.all(env);
end;

(* For tryExec: the file f run with the arguments av, its name first,
   and the environment ev; a file the kernel can't run (ENOEXEC) is a
   script for /bin/sh. err is why it failed, unless f wasn't there. *)
proc attempt(f: []U8; av, ev: [][]U8; var err: INT);
var sh: Names.Vec; e, k: INT;
begin
    e := -Sys.execve(f, av, ev);
    if e = Ccore.errNoExec then
        Names.init(sh, Ccore.temps);
        Names.push(sh, "/bin/sh");
        Names.push(sh, f);
        for k := 1 to LEN(av) - 1 do Names.push(sh, av[k]); end;
        _ := Sys.execve("/bin/sh", Names.all(sh), ev);
    end;
    if e # Ccore.errNoEnt then err := e; end;
end;

(* Is c a byte of a variable's name? *)
proc nameByte(c: U8): BOOL;
begin
    return (c >= 'a') and (c <= 'z') or (c >= 'A') and (c <= 'Z') or (c >= '0') and (c <= '9') or (c = '_');
end;

(* The program args name run in this process's place, looked for along
   PATH; if it can't be, why not said, and 126 or 127. *)
proc tryExec(args: []Ccore.Val): INT;
var words: Names.Vec; av, ev: [][]U8; name, path, dir: []U8; i, err: INT; b: Buf.Buf; slash, more: BOOL;
begin
    Names.init(words, Ccore.temps);
    for i := 0 to LEN(args) - 1 do Names.push(words, Ccore.bytes(Ccore.toStr(args[i]))); end;
    av := Names.all(words);
    ev := buildEnv();
    name := av[0];
    slash := Str.find(name, "/") >= 0;
    err := Ccore.errNoEnt;
    if slash then
        attempt(name, av, ev, err);
    elsif LEN(name) > 0 then
        path := Cvars.searchPath();
        more := true;
        while more do
            dir, path, more := Str.cut(path, ":");
            Buf.init(b, Ccore.temps);
            if LEN(dir) = 0 then dir := "."; end;
            Buf.str(b, dir);
            Buf.add(b, '/');
            Buf.str(b, name);
            attempt(Buf.bytes(b), av, ev, err);
        end;
    end;
    Ccore.errHead;
    Ccore.put(2, name);
    if err = Ccore.errNoEnt then
        Ccore.put(2, ": not found");
        (* sh's FOO=bar cmd *)
        i := 0;
        while (i < LEN(name)) and nameByte(name[i]) do INC(i); end;
        if (i > 0) and (i < LEN(name)) and (name[i] = '=') and ((name[0] < '0') or (name[0] > '9')) then
            Ccore.put(2, Ccore.text("; to set it, {} := ...; for one command, env {} command\n", [Fmt.str(name[0..i]), Fmt.str(name)]));
            return 127;
        end;
        if interactive and not slash then
            path := Ccomplete.suggestCommand(name);
            if LEN(path) > 0 then Ccore.put(2, Ccore.text("; did you mean {}?", [Fmt.str(path)])); end;
        end;
        Ccore.put(2, "\n");
        return 127;
    end;
    if err = Ccore.errAcces then Ccore.put(2, ": permission denied\n"); else Ccore.put(2, ": cannot execute\n"); end;
    return 126;
end;

proc execExternal(args: []Ccore.Val);
begin
    Sys.exit(tryExec(args));
end;

(* Is the list l a lone command, not in the background, which a child
   may exec over itself? *)
proc lone(l: []^Csyntax.Stmt): BOOL;
begin
    return (LEN(l) = 1) and (l[0]^.kind = Csyntax.sCmd) and (LEN(l[0]^.pipes) = 1) and not l[0]^.bg;
end;

(* In a child, standard output made w, and the list l run, the end of
   the child. *)
proc runInto(l: []^Csyntax.Stmt; w: INT);
begin
    _ := Sys.dupTo(w, 1);
    Sys.close(w);
    INC(exempt);    (* errexit passes captures by *)
    tailOk := lone(l);
    _ := execList(l);
    Sys.exit(Cvars.status());
end;

(* `list`: what the list writes, without the line feeds it ends in. *)
proc capture(l: []^Csyntax.Stmt): (Ccore.Val, ERROR);
var b: Buf.Buf; s: []U8; r, w, pid, k: INT;
begin
    r, w := Sys.pipe();
    if r < 0 then return {}, Ccore.fail("cannot make pipe"); end;
    pid := try fork();
    if pid = 0 then
        childSignals;
        Sys.close(r);
        runInto(l, w);
    end;
    Sys.close(w);
    Buf.init(b, Ccore.temps);
    while true do
        s := Buf.spare(b, 4096);
        k := Sys.read(r, s);
        if k > 0 then
            INC(b.len, k);
        elsif k = -Ccore.errIntr then
            noteSignals;
        else
            break;
        end;
    end;
    Sys.close(r);
    Cvars.setStatus(waitFor(pid));
    while (b.len > 0) and (Buf.bytes(b)[b.len - 1] = '\n') do DEC(b.len); end;
    return Ccore.bufVal(b), nil;
end;

(* The number of the command builtin called v, from 1; 0 if none is. *)
proc cmdBuiltin(v: Ccore.Val): INT;
var i: INT;
begin
    for i := 0 to LEN(Csyntax.CmdBuiltins) - 1 do
        if Ccore.bytes(v) = Csyntax.CmdBuiltins[i].name then return i + 1; end;
    end;
    return 0;
end;

(* Do the words a run outside the shell, neither procedure nor builtin? *)
proc extWords(a: []Ccore.Val): BOOL;
var nm: Ccore.Val;
begin
    if LEN(a) = 0 then return false; end;
    nm := Ccore.toStr(a[0]);
    return (Cvars.findProc(Ccore.bytes(nm)) = nil) and (cmdBuiltin(nm) = 0);
end;

(* Does the <(...) about to open belong to a job? Under job control a
   pipeline is one, and a single command that runs outside the shell:
   its name is expanded before any <(...) after it. A builtin or a
   procedure keeps the terminal in the shell, and its lists with it. *)
proc subJob: BOOL;
begin
    return jc and (subAll or (subSt # nil) and extWords(Vals.all(subSt^.args)));
end;

(* <(list): the list run with its output on a pipe, and the read end
   named, /dev/fd/N. The end stays open, and passed on to what is run,
   until the command that holds it is done (closeSubs). In a job, the
   first list leads the job's group and the rest join it, so that what
   the command runs joins it too, and all of them get the terminal. *)
proc openSub(l: []^Csyntax.Stmt): (Ccore.Val, ERROR);
var r, w, pid, i: INT; grp: BOOL;
begin
    if nsub >= MaxSubs then return {}, Ccore.fail("too many <(...)"); end;
    r, w := Sys.pipe();
    if r < 0 then return {}, Ccore.fail("cannot make pipe"); end;
    grp := subJob();
    pid := try fork();
    if pid = 0 then
        if grp then childJob(subPg, false); else childSignals; end;
        for i := 0 to nsub - 1 do Sys.close(subs[i].fd); end;    (* not the list's to hold *)
        nsub := 0;
        Sys.close(r);
        runInto(l, w);
    end;
    Sys.close(w);
    _ := Sys.keepOnExec(r, true);
    subs[nsub] := {fd: r, pid: pid};
    if grp then
        joinGroup(pid, subPg, false);
        if subPg = 0 then subPg := pid; end;
        subs[nsub].pg := subPg;
    end;
    INC(nsub);
    return Ccore.strVal(Ccore.text("/dev/fd/{}", [Fmt.int(r)])), nil;
end;

(* The <(...)s opened above lvl closed, then their lists reaped, whose
   status counts for nothing. Closing first lets a list still writing
   die of SIGPIPE rather than wait. One that has stopped wants the
   terminal its command has given back, and nobody will read what it
   writes: it is ended. *)
proc closeSubs(lvl: INT);
var e: Ended; i, r: INT;
begin
    for i := lvl to nsub - 1 do Sys.close(subs[i].fd); end;
    for i := lvl to nsub - 1 do
        while subs[i].pid > 0 do
            r, e.how, e.n := Sys.wait(subs[i].pid, true);
            if r = -Ccore.errIntr then
                noteSignals;
            elsif (r > 0) and (e.how = Sys.stopped) then
                _ := Sys.kill(subs[i].pid, Sys.sigTerm);
                _ := Sys.kill(subs[i].pid, Sys.sigCont);
            else
                subs[i].pid := 0;
            end;
        end;
    end;
    nsub := lvl;
end;

(* ------------------------------------------------------------ words *)

proc partVal(p: ^Csyntax.Part): (Ccore.Val, ERROR);
var r: ^Cvars.Var; b: Buf.Buf; h: []U8; ok: BOOL;
begin
    match p^.kind of
    | ptLit: return Ccore.strVal(p^.s), nil;
    | ptVar:
        r := Cvars.find(p^.s);
        if r = nil then return {}, Cvars.undefined(p^.s); end;
        return Ccore.temp(r^.v), nil;
    | ptExpr: return eval(p^.e);
    | ptCap: return capture(p^.cap);
    | ptSub: return openSub(p^.cap);
    | ptHome:
        if LEN(p^.s) = 0 then return Ccore.strVal(Cvars.home()), nil; end;
        h, ok := Cvars.userHome(p^.s);
        if ok then return Ccore.strVal(h), nil; end;
        Buf.init(b, Ccore.temps);    (* no such user *)
        Buf.add(b, '~');
        Buf.str(b, p^.s);
        return Ccore.bufVal(b), nil;
    end;
end;

proc interpolate(parts: []Csyntax.Part): (Ccore.Val, ERROR);
var b: Buf.Buf; i: INT;
begin
    Buf.init(b, Ccore.temps);
    for i := 0 to LEN(parts) - 1 do Buf.str(b, Ccore.bytes(Ccore.toStr(try partVal(ADR(parts[i]))))); end;
    return Ccore.bufVal(b), nil;
end;

(* The word w expanded, its fields added to out: a lone $x, $(e),
   `list` or <(list) unquoted gives a list's items each as a field;
   anything else is one field, or the paths it matches as a pattern. *)
proc expandWord(w: Csyntax.Word; var out: Vals.Vec): ERROR;
var v: Ccore.Val; plain, pat: Buf.Buf; s: []U8; i, k: INT; wild: BOOL;
begin
    if (LEN(w) = 1) and not w[0].quoted and (w[0].kind >= Csyntax.ptVar) and (w[0].kind # Csyntax.ptHome) then
        v := try partVal(ADR(w[0]));
        if v.kind = Ccore.kList then
            for i := 0 to INT(v.n) - 1 do Vals.push(out, Ccore.items(v)[i]); end;
        else
            Vals.push(out, v);
        end;
        return nil;
    end;
    Buf.init(plain, Ccore.temps);
    Buf.init(pat, Ccore.temps);
    for i := 0 to LEN(w) - 1 do
        s := Ccore.bytes(Ccore.toStr(try partVal(ADR(w[i]))));
        Buf.str(plain, s);
        if (w[i].kind = Csyntax.ptLit) and not w[i].quoted then
            Buf.str(pat, s);
            if Cglob.hasMeta(s) then wild := true; end;
        else
            for k := 0 to LEN(s) - 1 do
                match s[k] of
                | '*', '?', '[', '\\': Buf.add(pat, '\\');
                | else:
                end;
                Buf.add(pat, s[k]);
            end;
        end;
    end;
    if not wild then
        Vals.push(out, Ccore.bufVal(plain));
    elsif Cglob.glob(Buf.bytes(pat), out) = 0 then
        return Ccore.failOn(Buf.bytes(plain), "no match");
    end;
    return nil;
end;

proc expandRedirs(rs: []Csyntax.Redir): ([]Rx, ERROR);
var rx: []Rx; p: ^Rx; v: Vals.Vec; b: Buf.Buf; i: INT;
begin
    if LEN(rs) = 0 then return [], nil; end;
    p := ^Rx(Ccore.alloc(LEN(rs) * SIZE(Rx)));
    rx := p[0..LEN(rs)];
    for i := 0 to LEN(rs) - 1 do
        rx[i] := {kind: rs[i].kind, fd: rs[i].fd, fd2: rs[i].fd2};
        if rs[i].kind = Csyntax.rHere then
            Buf.init(b, Ccore.temps);
            Buf.str(b, Ccore.bytes(try interpolate(rs[i].target)));
            if rs[i].fd2 = 1 then Buf.add(b, '\n'); end;    (* <<< *)
            rx[i].s := Buf.bytes(b);
        elsif rs[i].kind # Csyntax.rDup then
            Vals.init(v, Ccore.temps);
            try expandWord(rs[i].target, v);
            if v.len # 1 then return [], Ccore.fail("ambiguous redirection"); end;
            rx[i].s := Ccore.bytes(Ccore.toStr(Vals.all(v)[0]));
        end;
    end;
    return rx, nil;
end;

(* The words and redirections of c, expanded into st. *)
proc expand(c: ^Csyntax.Cmd; var st: Stage): ERROR;
var i: INT;
begin
    Ccore.where^.line := c^.line;
    Ccore.where^.file := c^.path;
    Vals.init(st.args, Ccore.temps);
    for i := 0 to LEN(c^.words) - 1 do try expandWord(c^.words[i], st.args); end;
    st.rx := try expandRedirs(c^.redirs);
    return nil;
end;

(* ------------------------------------------------------- procedures *)

(* The list of a's items, which stay where they are. *)
proc listOf(a: []Ccore.Val): Ccore.Val;
begin
    if LEN(a) = 0 then return {kind: Ccore.kList}; end;
    return {kind: Ccore.kList, n: LEN(a), p: ^U8(ADR(a[0]))};
end;

(* The procedure def run with args, in a frame of its own: its
   parameters, args, the whole list, and for a function result, which
   is what it answers. *)
proc callProc(def: ^Csyntax.Stmt; args: []Ccore.Val): (Ccore.Val, ERROR);
var f: Cvars.Frame; up: ^Csyntax.Stmt; at: Ccore.Where; r: ^Cvars.Var; v: Ccore.Val; i: INT; err: ERROR;
begin
    f := try Cvars.enter();
    up := curFunc;
    at := Ccore.where^;
    curFunc := def;
    for i := 0 to LEN(def^.params) - 1 do
        r := Cvars.local(def^.params[i]);
        if i < LEN(args) then r^.v := Ccore.keep(args[i]); end;
    end;
    Cvars.local("args")^.v := Ccore.keep(listOf(args));
    if def^.isFunc then _ := Cvars.local("result"); end;
    err := execStmt(def^.body);
    ctl := cNone;
    if def^.isFunc and (err = nil) then
        r := Cvars.findLocal("result");    (* gone if the body unset it *)
        if r # nil then v := Ccore.temp(r^.v); end;
    end;
    Cvars.leave(f);
    curFunc := up;
    if err # nil then return {}, err; end;
    Ccore.where^ := at;    (* an error after the call is the caller's *)
    return v, nil;
end;

proc call(e: ^Csyntax.Expr): (Ccore.Val, ERROR);
var args: Vals.Vec; def: ^Csyntax.Stmt; i: INT;
begin
    if e^.bi # Csyntax.bNone then return builtin(e); end;
    Vals.init(args, Ccore.temps);
    for i := 0 to LEN(e^.args) - 1 do Vals.push(args, try eval(e^.args[i])); end;
    def := Cvars.findProc(e^.s);
    if def = nil then return {}, Cvars.unknownRoutine(e^.s); end;
    return callProc(def, Vals.all(args));
end;

(* ------------------------------------------------------------ traps *)

(* Trap entry i's procedure run, status left as it was. *)
proc runTrap(i: INT): ERROR;
var def: ^Csyntax.Stmt; m: Ccore.Mark; st: INT;
begin
    m := Ccore.mark();
    st := Cvars.status();
    def := Cvars.findProc(traps[i].name);
    if def = nil then
        Ccore.warnOn(traps[i].name, "trap: unknown routine");
    else
        _ := try callProc(def, []);
    end;
    Cvars.setStatus(st);
    Ccore.release(m);
    return nil;
end;

proc runTraps: ERROR;
var i: INT;
begin
    trapPending := false;
    for i := 1 to NTrap - 1 do
        if traps[i].pend then
            traps[i].pend := false;
            if traps[i].act = aProc then try runTrap(i); end;
        end;
    end;
    return nil;
end;

(* The procedures of the signals trapped that came, run. *)
proc checkTraps*: ERROR;
begin
    noteSignals;
    if trapPending then return runTraps(); end;
    return nil;
end;

(* The end of the shell, with status st: the EXIT trap first, and the
   terminal given back. *)
proc leave*(st: INT);
begin
    if not Ccore.opts^.inChild then
        _ := checkTraps();
        if traps[0].act = aProc then
            traps[0].act := aDefault;
            if runTrap(0) # nil then st := 2; end;    (* an error: the end all the same *)
        end;
        if jc then giveTerm(origPg); end;
    end;
    Sys.exit(st);
end;

(* ------------------------------------------------------ expressions *)

(* The order of a and b, -1, 0 or 1, and false if they have none: by
   number when either is an integer, byte by byte for two strings. *)
proc order(a, b: Ccore.Val): (INT, BOOL);
var i, j: I64; ia, ib: BOOL;
begin
    if (a.kind = Ccore.kInt) or (b.kind = Ccore.kInt) then
        i, ia := Ccore.isNum(a);
        j, ib := Ccore.isNum(b);
        if ia and ib then
            if i < j then return -1, true; end;
            if i > j then return 1, true; end;
            return 0, true;
        end;
    end;
    if (a.kind = Ccore.kStr) and (b.kind = Ccore.kStr) then return Str.cmp(Ccore.bytes(a), Ccore.bytes(b)), true; end;
    return 0, false;
end;

proc compare(a, b: Ccore.Val): (INT, ERROR);
var r: INT; ok: BOOL;
begin
    r, ok := order(a, b);
    if not ok then
        return 0, Ccore.fail(Ccore.text("cannot compare {} with {}", [Fmt.str(Ccore.kindName(a.kind)), Fmt.str(Ccore.kindName(b.kind))]));
    end;
    return r, nil;
end;

(* Does the case label l take v? A range a..b takes a <= v <= b. *)
proc matches(v: Ccore.Val; l: ^Csyntax.Expr): (BOOL, ERROR);
var r: INT; ok: BOOL;
begin
    if l^.kind # Csyntax.eRange then return Ccore.same(v, try eval(l)), nil; end;
    r, ok := order(v, try eval(l^.a));
    if not ok or (r < 0) then return false, nil; end;
    r, ok := order(v, try eval(l^.b));
    return ok and (r <= 0), nil;
end;

(* a and b, each a list's items or a value, in one list. *)
proc concat(a, b: Ccore.Val): Ccore.Val;
var out: Vals.Vec; i: INT;
begin
    Vals.init(out, Ccore.temps);
    if a.kind = Ccore.kList then
        for i := 0 to INT(a.n) - 1 do Vals.push(out, Ccore.items(a)[i]); end;
    else
        Vals.push(out, a);
    end;
    if b.kind = Ccore.kList then
        for i := 0 to INT(b.n) - 1 do Vals.push(out, Ccore.items(b)[i]); end;
    else
        Vals.push(out, b);
    end;
    return Ccore.listVal(out);
end;

(* Where sub starts in s, from 1; 0 if it doesn't. *)
proc search(s, sub: []U8): INT;
begin
    return Str.find(s, sub) + 1;
end;

proc binary(e: ^Csyntax.Expr): (Ccore.Val, ERROR);
var a, b: Ccore.Val; i, j: I64; k: INT; buf: Buf.Buf; ta: BOOL;
begin
    if e^.op = Csyntax.oAnd then
        if not try Ccore.truth(try eval(e^.a)) then return Ccore.boolVal(false), nil; end;
        return Ccore.boolVal(try Ccore.truth(try eval(e^.b))), nil;
    end;
    if e^.op = Csyntax.oOr then
        if try Ccore.truth(try eval(e^.a)) then return Ccore.boolVal(true), nil; end;
        return Ccore.boolVal(try Ccore.truth(try eval(e^.b))), nil;
    end;
    a := try eval(e^.a);
    b := try eval(e^.b);
    match e^.op of
    | oAdd:
        if (a.kind = Ccore.kInt) and (b.kind = Ccore.kInt) then return Ccore.intVal(try Ccore.intAdd(a.n, b.n)), nil; end;
        if (a.kind = Ccore.kList) or (b.kind = Ccore.kList) then return concat(a, b), nil; end;
        Buf.init(buf, Ccore.temps);
        Buf.str(buf, Ccore.bytes(Ccore.toStr(a)));
        Buf.str(buf, Ccore.bytes(Ccore.toStr(b)));
        return Ccore.bufVal(buf), nil;
    | oSub:
        i := try Ccore.toInt(a);
        return Ccore.intVal(try Ccore.intSub(i, try Ccore.toInt(b))), nil;
    | oMul:
        i := try Ccore.toInt(a);
        return Ccore.intVal(try Ccore.intMul(i, try Ccore.toInt(b))), nil;
    | oDiv, oMod:
        i := try Ccore.toInt(a);
        j := try Ccore.toInt(b);
        if j = 0 then return {}, Ccore.fail("division by zero"); end;
        if (j = -1) and (i = Ccore.MinI64) then    (* the one quotient too big *)
            if e^.op = Csyntax.oDiv then return {}, Ccore.overflow(); end;
            return Ccore.intVal(0), nil;
        end;
        if e^.op = Csyntax.oDiv then return Ccore.intVal(i div j), nil; end;
        return Ccore.intVal(i mod j), nil;
    | oXor:
        ta := try Ccore.truth(a);
        return Ccore.boolVal(ta # try Ccore.truth(b)), nil;
    | oEq: return Ccore.boolVal(Ccore.same(a, b)), nil;
    | oNe: return Ccore.boolVal(not Ccore.same(a, b)), nil;
    | oLt: return Ccore.boolVal(try compare(a, b) < 0), nil;
    | oGt: return Ccore.boolVal(try compare(a, b) > 0), nil;
    | oLe: return Ccore.boolVal(try compare(a, b) <= 0), nil;
    | oGe: return Ccore.boolVal(try compare(a, b) >= 0), nil;
    | oIn:
        if b.kind = Ccore.kList then
            for k := 0 to INT(b.n) - 1 do
                if Ccore.same(a, Ccore.items(b)[k]) then return Ccore.boolVal(true), nil; end;
            end;
            return Ccore.boolVal(false), nil;
        end;
        if b.kind = Ccore.kStr then
            a := Ccore.toStr(a);
            return Ccore.boolVal((a.n = 0) or (search(Ccore.bytes(b), Ccore.bytes(a)) > 0)), nil;
        end;
        return {}, Ccore.fail("'in' needs a list or string");
    | else: return {}, nil;
    end;
end;

(* A variable's value where it is, or an expression's. *)
proc valueOf(e: ^Csyntax.Expr): (Ccore.Val, ERROR);
var r: ^Cvars.Var;
begin
    if e^.kind # Csyntax.eVar then return eval(e); end;
    r := Cvars.find(e^.s);
    if r = nil then return {}, Cvars.undefined(e^.s); end;
    return r^.v, nil;
end;

(* a[i]: a string's ith byte, from 1, or a list's ith item, from 0;
   read where it is, so that a loop over a list isn't quadratic. *)
proc index(e: ^Csyntax.Expr): (Ccore.Val, ERROR);
var i: I64; v: Ccore.Val;
begin
    i := try Ccore.toInt(try eval(e^.b));
    v := try valueOf(e^.a);
    match v.kind of
    | kStr:
        if (i < 1) or (i > v.n) then return {}, Ccore.fail("index out of range"); end;
        return Ccore.strVal(Ccore.bytes(v)[i - 1..i]), nil;
    | kList:
        if (i < 0) or (i >= v.n) then return {}, Ccore.fail("index out of range"); end;
        return Ccore.temp(Ccore.items(v)[i]), nil;
    | else: return {}, Ccore.fail(Ccore.text("cannot index {}", [Fmt.str(Ccore.kindName(v.kind))]));
    end;
end;

proc eval(e: ^Csyntax.Expr): (Ccore.Val, ERROR);
var r: ^Cvars.Var; out: Vals.Vec; i: INT;
begin
    match e^.kind of
    | eLit: return e^.v, nil;
    | eVar:
        r := Cvars.find(e^.s);
        if r = nil then return {}, Cvars.undefined(e^.s); end;
        return Ccore.temp(r^.v), nil;
    | eIndex: return index(e);
    | eCall: return call(e);
    | eBin: return binary(e);
    | eNeg: return Ccore.intVal(try Ccore.intNeg(try Ccore.toInt(try eval(e^.a)))), nil;
    | eNot: return Ccore.boolVal(not try Ccore.truth(try eval(e^.a))), nil;
    | eList:
        Vals.init(out, Ccore.temps);
        for i := 0 to LEN(e^.args) - 1 do Vals.push(out, try eval(e^.args[i])); end;
        return Ccore.listVal(out), nil;
    | eInterp: return interpolate(e^.parts);
    | eCap: return capture(e^.cap);
    | eRange: return {}, nil;
    end;
end;

(* --------------------------------------------------------- builtins *)

proc source(path: []U8): ERROR;
var b: Buf.Buf; e: INT;
begin
    Buf.init(b, Ccore.temps);
    e := Ccore.readFile(path, b);
    if e < 0 then return Ccore.failOn(path, Ccore.text("cannot read: {}", [Fmt.str(Ccore.errText(-e))])); end;
    try runText(Buf.bytes(b), Ccore.perm(path));
    if ctl = cExit then ctl := cNone; end;
    return nil;
end;

(* source, run by the prompt procedure: an error in the file is shown
   and gives status 1, and the prompt goes on. Unguarded, the error
   would reach the REPL, which turns the prompt procedure off for good.
   Any other error (Ctrl-C, errexit) is passed on. *)
proc sourceGuarded(path: []U8): (INT, ERROR);
var f: Cvars.Frame; up: ^Csyntax.Stmt; lvl, ns, ex: INT; err: ERROR;
begin
    lvl := nsave;
    ns := nsub;
    f := Cvars.here();
    up := curFunc;
    ex := exempt;
    err := source(path);
    if err = nil then return Cvars.status(), nil; end;
    restoreFds(lvl);
    closeSubs(ns);
    Cvars.leave(f);
    curFunc := up;
    exempt := ex;
    ctl := cNone;
    tailOk := false;
    keepFds := false;
    if err # Ccore.Failed then return 0, err; end;
    return 1, nil;
end;

(* errHead, then msg on standard error. *)
proc complain(msg: []U8);
begin
    Ccore.errHead;
    Ccore.put(2, msg);
end;

(* wait [pid ...]: the status of the last process reaped, 127 for a
   pid that isn't a child of the shell's. *)
proc waitJobs(a: []Ccore.Val): INT;
var e: Ended; v: Ccore.Val; i: I64; r, target, k, j, pid: INT; ok: BOOL;
begin
    k := 1;
    repeat
        target := -1;
        if LEN(a) > 1 then
            v := Ccore.toStr(a[k]);
            i, ok := Ccore.isNum(v);
            if not ok or (i <= 0) then
                complain(Ccore.text("wait: not a process id: {}\n", [Fmt.str(Ccore.bytes(v))]));
                return 1;
            end;
            target := INT(i);
        end;
        while true do
            pid, e.how, e.n := Sys.wait(target, true);
            if pid < 0 then
                if pid = -Ccore.errIntr then
                    noteSignals;
                    if not intr and not trapPending then continue; end;
                end;
                if pid = -Ccore.errChild then
                    if target > 0 then r := 127; end;
                else
                    r := 128 + Sys.sigInt;
                end;
                break;
            end;
            if e.how # Sys.stopped then    (* the Pascal waited without WUNTRACED *)
                j := reaped(pid, e);
                if (j >= 0) and (Jobs.all(jobs)[j].left = 0) then dropJob(j); end;
                r := exitCode(e);
                if target > 0 then break; end;
            end;
        end;
        INC(k);
    until k >= LEN(a);
    return r;
end;

(* The job fg, bg or disown (who) means: its number, with or without %,
   or the current job; -1, having said why, if there is none. *)
proc jobArg(a: []Ccore.Val; who: []U8): INT;
var v, w: []U8; js: []Job; i: I64; k: INT; ok: BOOL;
begin
    js := Jobs.all(jobs);
    if LEN(a) > 1 then
        v := Ccore.bytes(Ccore.toStr(a[1]));
        w := v;
        if (LEN(v) > 0) and (v[0] = '%') then v := v[1..LEN(v)]; end;
        i, ok := Ccore.isNum(Ccore.strVal(v));
        if ok then
            for k := 0 to LEN(js) - 1 do
                if js[k].id = i then return k; end;
            end;
        end;
        complain(Ccore.text("{}: no such job: {}\n", [Fmt.str(who), Fmt.str(w)]));
        return -1;
    end;
    if LEN(js) = 0 then complain(Ccore.text("{}: no current job\n", [Fmt.str(who)])); end;
    return LEN(js) - 1;
end;

(* jobs: a line each, the current job marked +. *)
proc listJobs: INT;
var js: []Job; b: Buf.Buf; k: INT;
begin
    if interactive then reapJobs; end;
    js := Jobs.all(jobs);
    Buf.init(b, Ccore.temps);
    for k := 0 to LEN(js) - 1 do
        Buf.reset(b);
        Fmt.write(b, "[{}]", [Fmt.int(js[k].id)]);
        if k = LEN(js) - 1 then Buf.str(b, "+ "); else Buf.str(b, "  "); end;
        Fmt.write(b, "{}", [Fmt.int(js[k].pgid)]);
        if js[k].stopped then Buf.str(b, " stopped "); else Buf.str(b, " running "); end;
        Buf.str(b, js[k].name);
        Buf.add(b, '\n');
        Ccore.put(1, Buf.bytes(b));
    end;
    return 0;
end;

(* fg [job]: a job continued in the foreground, and waited for. *)
proc fgJob(a: []Ccore.Val): (INT, ERROR);
var j: ^Job; k: INT;
begin
    if not jc then
        complain("fg: no job control\n");
        return 1, nil;
    end;
    k := jobArg(a, "fg");
    if k < 0 then return 1, nil; end;
    j := ADR(Jobs.all(jobs)[k]);
    Ccore.put(2, Ccore.text("{}\n", [Fmt.str(j^.name)]));
    giveTerm(j^.pgid);
    if j^.stopped then
        if j^.hasTio then _ := Sys.setMode(0, j^.tio); end;
        j^.stopped := false;
        _ := Sys.kill(-j^.pgid, Sys.sigCont);
    end;
    return waitJob(k);
end;

(* bg [job]: a stopped job continued in the background. *)
proc bgJob(a: []Ccore.Val): INT;
var j: ^Job; k: INT;
begin
    k := jobArg(a, "bg");
    if k < 0 then return 1; end;
    j := ADR(Jobs.all(jobs)[k]);
    if j^.stopped then
        j^.stopped := false;
        _ := Sys.kill(-j^.pgid, Sys.sigCont);
        report(k, "running");
    end;
    return 0;
end;

(* disown [job]: a job forgotten, so that the hangup passes it by; a
   stopped one is continued first, with nobody left to do it later. *)
proc disownJob(a: []Ccore.Val): INT;
var k: INT;
begin
    k := jobArg(a, "disown");
    if k < 0 then return 1; end;
    if Jobs.all(jobs)[k].stopped then _ := Sys.kill(-Jobs.all(jobs)[k].pgid, Sys.sigCont); end;
    dropJob(k);
    return 0;
end;

(* ulimit's complaint, msg perhaps from Ccore.text: 1. *)
proc badLimit(msg: []U8): INT;
begin
    complain("ulimit: ");
    Ccore.put(2, msg);
    Ccore.put(2, "\n");
    return 1;
end;

(* ulimit [-c | -f | -n | -s | -t | -v] [value | unlimited]: a soft
   limit shown or set, in kilobytes but for -n and -t. *)
proc ulimit(a: []Ccore.Val): INT;
var v: []U8; soft, hard, i: I64; which, scale, k, e: INT; ok: BOOL;
begin
    which := Sys.limitFileSize;
    scale := 1024;
    k := 1;
    if LEN(a) > 1 then
        v := Ccore.bytes(Ccore.toStr(a[1]));
        if (LEN(v) = 2) and (v[0] = '-') then
            match v[1] of
            | 'c': which := Sys.limitCore;
            | 'f': which := Sys.limitFileSize;
            | 'n':
                which := Sys.limitFiles;
                scale := 1;
            | 's': which := Sys.limitStack;
            | 't':
                which := Sys.limitCpu;
                scale := 1;
            | 'v': which := Sys.limitMemory;
            | else: return badLimit(Ccore.text("unknown option {}", [Fmt.str(v)]));
            end;
            k := 2;
        end;
    end;
    if LEN(a) > k + 1 then return badLimit("too many arguments"); end;
    soft, hard, e := Sys.limit(which);
    if e # 0 then return badLimit(Ccore.errText(-e)); end;
    if LEN(a) = k then
        if soft = -1 then
            Ccore.put(1, "unlimited\n");
        else
            Ccore.put(1, Ccore.text("{}\n", [Fmt.int(soft div scale)]));
        end;
        return 0;
    end;
    v := Ccore.bytes(Ccore.toStr(a[k]));
    if v = "unlimited" then
        soft := -1;
    else
        i, ok := Ccore.isNum(Ccore.strVal(v));
        if not ok or (i < 0) or (i > Ccore.MaxI64 div scale) then return badLimit(Ccore.text("not a limit: {}", [Fmt.str(v)])); end;
        soft := i * scale;
    end;
    e := Sys.setLimit(which, soft, hard);
    if e # 0 then return badLimit(Ccore.errText(-e)); end;
    return 0;
end;

(* trap name|-|'' signal ...: a procedure for each signal, or it
   ignored, or back to the shell's default. *)
proc trap(a: []Ccore.Val): INT;
var act, v: []U8; r, i, j, k: INT; ok: BOOL;
begin
    if LEN(a) < 3 then
        complain("trap: usage: trap name|-|'' signal...\n");
        return 1;
    end;
    act := Ccore.bytes(Ccore.toStr(a[1]));
    for k := 2 to LEN(a) - 1 do
        v := Ccore.bytes(Ccore.toStr(a[k]));
        j := -1;
        for i := 0 to NTrap - 1 do
            if v = TrapNames[i] then j := i; end;
        end;
        if j < 0 then
            complain(Ccore.text("trap: unknown signal {}\n", [Fmt.str(v)]));
            r := 1;
            continue;
        end;
        Str.free(Heap.heap, traps[j].name);
        traps[j].name := "";
        if LEN(act) = 0 then
            traps[j].act := aIgnore;
        elsif act = "-" then
            traps[j].act := aDefault;
        else
            traps[j].act := aProc;
            traps[j].name, ok := Str.copy(Heap.heap, act);
            if not ok then Rt.stop("concha: out of memory\n"); end;
        end;
        if j > 0 then applySig(j); end;
    end;
    return r;
end;

(* cd [dir], cd -: PWD and OLDPWD kept. *)
proc cd(a: []Ccore.Val): (INT, ERROR);
var r: ^Cvars.Var; v, old: Ccore.Val; d: []U8; e: INT; toOld: BOOL;
begin
    toOld := (LEN(a) > 1) and (a[1].kind = Ccore.kStr) and (Ccore.bytes(a[1]) = "-");
    if toOld then
        r := Cvars.findGlobal("OLDPWD");
        if r = nil then
            complain("cd: OLDPWD not set\n");
            return 1, nil;
        end;
        v := Ccore.toStr(r^.v);
    elsif LEN(a) > 1 then
        v := Ccore.toStr(a[1]);
    else
        v := Ccore.strVal(Cvars.home());
    end;
    old := Ccore.strVal(Cvars.str("PWD"));
    e := Sys.setWorkDir(Ccore.bytes(v));
    if e # 0 then
        complain(Ccore.text("cd: {}: {}\n", [Fmt.str(Ccore.bytes(v)), Fmt.str(Ccore.errText(-e))]));
        return 1, nil;
    end;
    r := Cvars.global("OLDPWD");
    try Cvars.store(r, old);
    r^.exported := true;
    d, e := Sys.workDir();
    if e = 0 then
        try Cvars.store(Cvars.global("PWD"), Ccore.strVal(d));
        if toOld then Ccore.put(1, Ccore.text("{}\n", [Fmt.str(d)])); end;
    end;
    return 0, nil;
end;

proc echo(a: []Ccore.Val);
var b: Buf.Buf; i, k: INT; nl: BOOL;
begin
    Buf.init(b, Ccore.temps);
    i := 1;
    nl := true;
    if (LEN(a) > 1) and (a[1].kind = Ccore.kStr) and (Ccore.bytes(a[1]) = "-n") then
        nl := false;
        i := 2;
    end;
    for k := i to LEN(a) - 1 do
        if k > i then Buf.add(b, ' '); end;
        Buf.str(b, Ccore.bytes(Ccore.toStr(a[k])));
    end;
    if nl then Buf.add(b, '\n'); end;
    Ccore.put(1, Buf.bytes(b));
end;

(* umask [mode]: the mask shown, in octal, or set. *)
proc umask(a: []Ccore.Val): INT;
var d: [4]U8; v: []U8; mask, k: INT;
begin
    if LEN(a) < 2 then
        mask := Sys.umask(0);
        _ := Sys.umask(mask);
        for k := 3 to 0 by -1 do
            d[k] := U8('0' + mask & 7);
            mask := mask shr 3;
        end;
        Ccore.put(1, Ccore.text("{}\n", [Fmt.str(d)]));
        return 0;
    end;
    v := Ccore.bytes(Ccore.toStr(a[1]));
    for k := 0 to LEN(v) - 1 do
        if (v[k] >= '0') and (v[k] <= '7') and (mask < 512) then
            mask := mask * 8 + v[k] - '0';
        else
            mask := 4096;    (* 512, 4096 and 4095 are octal 1000, 10000 and 7777 *)
        end;
    end;
    if (LEN(v) = 0) or (mask > 4095) then
        complain(Ccore.text("umask: not an octal mode: {}\n", [Fmt.str(v)]));
        return 1;
    end;
    _ := Sys.umask(mask);
    return 0;
end;

(* The command builtin bi, from 1 as cmdBuiltin numbers them, run with
   the words a: its status. *)
proc runCmdBuiltin(bi: INT; a: []Ccore.Val): (INT, ERROR);
var v: []U8; r, k: INT;
begin
    match Csyntax.CmdBuiltins[bi - 1].name of
    | "cd": return cd(a);
    | "echo": echo(a);
    | "source":
        if LEN(a) < 2 then return 0, Ccore.fail("source: missing file"); end;
        v := Ccore.bytes(Ccore.toStr(a[1]));
        if inPromptProc then return sourceGuarded(v); end;
        try source(v);
        return Cvars.status(), nil;
    | "wait": return waitJobs(a), nil;
    | "exec":
        if LEN(a) = 1 then
            keepFds := true;
            return 0, nil;
        end;
        execSignals;
        r := tryExec(a[1..LEN(a)]);
        if not Ccore.opts^.inChild then onSignals; end;
        return r, nil;
    | "umask": return umask(a), nil;
    | "unset":
        for k := 1 to LEN(a) - 1 do
            v := Ccore.bytes(Ccore.toStr(a[k]));
            if LEN(v) > 0 then try Cvars.unset(v); end;
        end;
    | "ulimit": return ulimit(a), nil;
    | "trap": return trap(a), nil;
    | "jobs": return listJobs(), nil;
    | "fg": return fgJob(a);
    | "bg": return bgJob(a), nil;
    | "disown": return disownJob(a), nil;
    | else:
    end;
    return 0, nil;
end;

(* A builtin routine's arguments, between lo and hi of them. *)
proc need(e: ^Csyntax.Expr; lo, hi: INT): (INT, ERROR);
begin
    if (LEN(e^.args) < lo) or (LEN(e^.args) > hi) then return 0, Ccore.failOn(e^.s, "wrong number of arguments"); end;
    return LEN(e^.args), nil;
end;

proc argStr(e: ^Csyntax.Expr; i: INT): ([]U8, ERROR);
begin
    return Ccore.bytes(Ccore.toStr(try eval(e^.args[i]))), nil;
end;

(* The variable a builtin routine's first argument must be. *)
proc lvar(e: ^Csyntax.Expr): (^Csyntax.Expr, ERROR);
begin
    if e^.args[0]^.kind # Csyntax.eVar then return nil, Ccore.failOn(e^.s, "needs a variable"); end;
    return e^.args[0], nil;
end;

(* A line of standard input, without its line feed, read a byte at a
   time so that nothing past it is taken; false at the end. *)
proc readLine: (Ccore.Val, BOOL, ERROR);
var b: Buf.Buf; c: [1]U8; k: INT; got: BOOL;
begin
    Buf.init(b, Ccore.temps);
    while true do
        k := Sys.read(0, c);
        if k = -Ccore.errIntr then
            noteSignals;
            if intr then return {}, false, interrupted(); end;
        elsif k <= 0 then
            break;
        else
            got := true;
            if c[0] = '\n' then break; end;
            Buf.add(b, c[0]);
        end;
    end;
    return Ccore.bufVal(b), got, nil;
end;

proc isBlank(c: U8): BOOL;
begin
    return (c = ' ') or (c = '\t') or (c = '\n') or (c = '\r');
end;

(* s cut at each sep, or into its words if sep is empty: a list. *)
proc split(s, sep: []U8): Ccore.Val;
var out: Vals.Vec; i, j: INT;
begin
    Vals.init(out, Ccore.temps);
    if LEN(sep) = 0 then
        i := 0;
        while true do
            while (i < LEN(s)) and isBlank(s[i]) do INC(i); end;
            if i >= LEN(s) then break; end;
            j := i;
            while (j < LEN(s)) and not isBlank(s[j]) do INC(j); end;
            Vals.push(out, Ccore.strVal(s[i..j]));
            i := j;
        end;
    elsif LEN(s) > 0 then
        while true do
            j := Str.find(s, sep);
            if j < 0 then
                Vals.push(out, Ccore.strVal(s));
                break;
            end;
            Vals.push(out, Ccore.strVal(s[0..j]));
            s := s[j + LEN(sep)..LEN(s)];
        end;
    end;
    return Ccore.listVal(out);
end;

(* a sorted in place by compare, keeping equals in order: a merge sort,
   bottom up. *)
proc sortVals(a: []Ccore.Val): ERROR;
var tmp: Vals.Vec; src, dst, t: []Ccore.Val; w, lo, mid, hi, l, r, k: INT;
begin
    Vals.init(tmp, Ccore.temps);
    Vals.resize(tmp, LEN(a));
    src := a;
    dst := Vals.all(tmp);
    w := 1;
    while w < LEN(a) do
        lo := 0;
        while lo < LEN(a) do
            mid := lo + w;
            if mid > LEN(a) then mid := LEN(a); end;
            hi := mid + w;
            if hi > LEN(a) then hi := LEN(a); end;
            l := lo;
            r := mid;
            for k := lo to hi - 1 do
                if (l < mid) and ((r >= hi) or (try compare(src[l], src[r]) <= 0)) then
                    dst[k] := src[l];
                    INC(l);
                else
                    dst[k] := src[r];
                    INC(r);
                end;
            end;
            lo := hi;
        end;
        t := src;
        src := dst;
        dst := t;
        w := w * 2;
    end;
    if LEN(a) > 0 then
        if ADR(src[0]) # ADR(a[0]) then COPY(a, src); end;
    end;
    return nil;
end;

(* A name the environment can hold: not empty, no = and no NUL. *)
proc envName(s: []U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(s) - 1 do
        if (s[i] = '=') or (s[i] = 0) then return false; end;
    end;
    return LEN(s) > 0;
end;

(* copy(x, i[, n]): of a string, n bytes from the ith, from 1; of a
   list, n items from the ith, from 0; cut to what there is. *)
proc copyOf(e: ^Csyntax.Expr; n: INT): (Ccore.Val, ERROR);
var a: Ccore.Val; i, k: I64;
begin
    a := try eval(e^.args[0]);
    i := try Ccore.toInt(try eval(e^.args[1]));
    k := 7FFFFFFFH;
    if n = 3 then k := try Ccore.toInt(try eval(e^.args[2])); end;
    if a.kind = Ccore.kStr then
        DEC(i);
    elsif a.kind # Ccore.kList then
        a := Ccore.toStr(a);    (* from 0, as the Pascal had it *)
    end;
    if i < 0 then
        k := k + i;
        i := 0;
    end;
    if i > a.n then i := a.n; end;
    if k > a.n - i then k := a.n - i; end;
    if k < 0 then k := 0; end;
    if a.kind = Ccore.kList then return listOf(Ccore.items(a)[i..i + k]), nil; end;
    return Ccore.strVal(Ccore.bytes(a)[i..i + k]), nil;
end;

(* basename(p[, suffix]) and dirname(p), as POSIX has them: slashes at
   the end don't count, and / stays /. *)
proc pathPart(e: ^Csyntax.Expr; n: INT): (Ccore.Val, ERROR);
var a, x: []U8; i, k: INT;
begin
    a := try argStr(e, 0);
    k := LEN(a);
    while (k > 1) and (a[k - 1] = '/') do DEC(k); end;
    i := k;
    while (i > 0) and (a[i - 1] # '/') do DEC(i); end;
    if e^.bi = Csyntax.bDirname then
        if i = 0 then return Ccore.strVal("."), nil; end;
        while (i > 1) and (a[i - 1] = '/') do DEC(i); end;
        return Ccore.strVal(a[0..i]), nil;
    end;
    if (i = k) and (k > 0) then DEC(i); end;    (* the root itself *)
    if n = 2 then
        x := try argStr(e, 1);    (* a suffix, unless it is all of it *)
        if (LEN(x) < k - i) and (a[k - LEN(x)..k] = x) then k := k - LEN(x); end;
    end;
    return Ccore.strVal(a[i..k]), nil;
end;

(* The builtin routine e calls. *)
proc builtin(e: ^Csyntax.Expr): (Ccore.Val, ERROR);
var
    a, b, c: []U8; v: Ccore.Val; buf: Buf.Buf; out: Vals.Vec; x: ^Csyntax.Expr; r: ^Cvars.Var; g: []Cvars.Var;
    n, i, k: INT; ia, ib: I64; got: BOOL;
begin
    match e^.bi of
    | bWrite, bWriteln:
        n := try need(e, 0, 999);
        Buf.init(buf, Ccore.temps);
        for i := 0 to n - 1 do Buf.str(buf, try argStr(e, i)); end;
        if e^.bi = Csyntax.bWriteln then Buf.add(buf, '\n'); end;
        Ccore.put(1, Buf.bytes(buf));
    | bReadln:
        _ := try need(e, 1, 1);
        x := try lvar(e);
        v, got := try readLine();
        try Cvars.assign(x^.s, v);
        return Ccore.boolVal(got), nil;
    | bInc, bDec:
        n := try need(e, 1, 2);
        x := try lvar(e);
        ia := 1;
        if n = 2 then ia := try Ccore.toInt(try eval(e^.args[1])); end;
        r := Cvars.find(x^.s);
        if r = nil then return {}, Cvars.undefined(x^.s); end;
        ib := try Ccore.toInt(r^.v);
        if e^.bi = Csyntax.bDec then ia := try Ccore.intSub(ib, ia); else ia := try Ccore.intAdd(ib, ia); end;
        try Cvars.store(r, Ccore.intVal(ia));
    | bHalt:
        n := try need(e, 0, 1);
        if n = 1 then leave(INT(I32(try Ccore.toInt(try eval(e^.args[0]))))); end;
        leave(Cvars.status());
    | bLength:
        _ := try need(e, 1, 1);
        v := try valueOf(e^.args[0]);
        if (v.kind = Ccore.kBool) or (v.kind = Ccore.kInt) then
            return {}, Ccore.fail(Ccore.text("length of {}", [Fmt.str(Ccore.kindName(v.kind))]));
        end;
        return Ccore.intVal(v.n), nil;
    | bCopy: return copyOf(e, try need(e, 2, 3));
    | bPos:
        _ := try need(e, 2, 2);
        a := try argStr(e, 0);
        b := try argStr(e, 1);
        if LEN(a) = 0 then return Ccore.intVal(0), nil; end;
        return Ccore.intVal(search(b, a)), nil;
    | bInt:
        _ := try need(e, 1, 1);
        return Ccore.intVal(try Ccore.toInt(try eval(e^.args[0]))), nil;
    | bStr:
        _ := try need(e, 1, 1);
        return Ccore.toStr(try eval(e^.args[0])), nil;
    | bTrim:
        _ := try need(e, 1, 1);
        a := try argStr(e, 0);
        i := 0;
        k := LEN(a);
        while (i < k) and isBlank(a[i]) do INC(i); end;
        while (k > i) and isBlank(a[k - 1]) do DEC(k); end;
        return Ccore.strVal(a[i..k]), nil;
    | bSplit:
        n := try need(e, 1, 2);
        a := try argStr(e, 0);
        b := "";
        if n = 2 then b := try argStr(e, 1); end;
        return split(a, b), nil;
    | bLines:
        _ := try need(e, 1, 1);
        a := try argStr(e, 0);
        if (LEN(a) > 0) and (a[LEN(a) - 1] = '\n') then a := a[0..LEN(a) - 1]; end;
        if LEN(a) = 0 then return {kind: Ccore.kList}, nil; end;
        return split(a, "\n"), nil;
    | bJoin:
        n := try need(e, 1, 2);
        v := try eval(e^.args[0]);
        if v.kind # Ccore.kList then return {}, Ccore.fail("join needs a list"); end;
        b := " ";
        if n = 2 then b := try argStr(e, 1); end;
        Buf.init(buf, Ccore.temps);
        for i := 0 to INT(v.n) - 1 do
            if i > 0 then Buf.str(buf, b); end;
            Buf.str(buf, Ccore.bytes(Ccore.toStr(Ccore.items(v)[i])));
        end;
        return Ccore.bufVal(buf), nil;
    | bGlob:
        _ := try need(e, 1, 1);
        Vals.init(out, Ccore.temps);
        _ := Cglob.glob(try argStr(e, 0), out);
        return Ccore.listVal(out), nil;
    | bExists:
        _ := try need(e, 1, 1);
        return Ccore.boolVal(Cglob.pathKind(try argStr(e, 0)) # Cglob.none), nil;
    | bIsDir:
        _ := try need(e, 1, 1);
        return Ccore.boolVal(Cglob.pathKind(try argStr(e, 0)) = Cglob.dir), nil;
    | bIsFile:
        _ := try need(e, 1, 1);
        return Ccore.boolVal(Cglob.pathKind(try argStr(e, 0)) = Cglob.file), nil;
    | bChr:
        _ := try need(e, 1, 1);
        ia := try Ccore.toInt(try eval(e^.args[0]));
        v := Ccore.strVal(" ");
        Ccore.bytes(v)[0] := U8(ia & 255);
        return v, nil;
    | bOrd:
        _ := try need(e, 1, 1);
        a := try argStr(e, 0);
        if LEN(a) = 0 then return {}, Ccore.fail("ord of empty string"); end;
        return Ccore.intVal(I64(a[0])), nil;
    | bUpcase, bLowcase:
        _ := try need(e, 1, 1);
        v := Ccore.strVal(try argStr(e, 0));
        if e^.bi = Csyntax.bUpcase then Str.upper(Ccore.bytes(v)); else Str.lower(Ccore.bytes(v)); end;
        return v, nil;
    | bMatch:
        _ := try need(e, 2, 2);
        a := try argStr(e, 0);
        b := try argStr(e, 1);
        return Ccore.boolVal(Cglob.matches(b, a)), nil;
    | bDefined:
        _ := try need(e, 1, 1);
        return Ccore.boolVal(Cvars.find(try argStr(e, 0)) # nil), nil;
    | bEnviron:
        _ := try need(e, 0, 0);
        Vals.init(out, Ccore.temps);
        g := Cvars.allGlobals();
        for i := 0 to LEN(g) - 1 do
            if g[i].exported then Vals.push(out, Ccore.strVal(g[i].name)); end;
        end;
        try sortVals(Vals.all(out));
        return Ccore.listVal(out), nil;
    | bGetenv:
        _ := try need(e, 1, 1);
        r := Cvars.findGlobal(try argStr(e, 0));
        if (r # nil) and r^.exported then return Ccore.toStr(r^.v), nil; end;
        return {kind: Ccore.kStr}, nil;
    | bSetenv:
        _ := try need(e, 2, 2);
        a := try argStr(e, 0);
        b := try argStr(e, 1);
        if not envName(a) then return {}, Ccore.failOn(e^.s, "not a variable name"); end;
        r := Cvars.findGlobal(a);
        if r = nil then r := Cvars.global(Ccore.perm(a)); end;
        try Cvars.store(r, Ccore.strVal(b));
        r^.exported := true;
    | bNow:
        _ := try need(e, 0, 0);
        return Ccore.intVal(Sys.now() div 1000000), nil;
    | bTime:
        n := try need(e, 1, 2);
        ia := Sys.now() div 1000000;
        if n = 2 then ia := try Ccore.toInt(try eval(e^.args[1])); end;
        return Ccore.strVal(try Cclock.format(try argStr(e, 0), ia)), nil;
    | bBasename: return pathPart(e, try need(e, 1, 2));
    | bDirname: return pathPart(e, try need(e, 1, 1));
    | bCompletions:    (* what Tab would offer at the end of the line, as Tab finds it *)
        _ := try need(e, 1, 1);
        return Cedit.completions(try argStr(e, 0), complete), nil;
    | bSort:
        _ := try need(e, 1, 1);
        v := try eval(e^.args[0]);
        if v.kind # Ccore.kList then
            return {}, Ccore.fail(Ccore.text("sort needs a list, got {}", [Fmt.str(Ccore.kindName(v.kind))]));
        end;
        Vals.init(out, Ccore.temps);
        for i := 0 to INT(v.n) - 1 do Vals.push(out, Ccore.items(v)[i]); end;
        try sortVals(Vals.all(out));
        return Ccore.listVal(out), nil;
    | bReplace:
        _ := try need(e, 3, 3);
        a := try argStr(e, 0);
        b := try argStr(e, 1);
        c := try argStr(e, 2);
        if LEN(b) = 0 then return {}, Ccore.failOn(e^.s, "nothing to replace"); end;
        Buf.init(buf, Ccore.temps);
        Str.replace(buf, a, b, c);
        return Ccore.bufVal(buf), nil;
    | bNone:
    end;
    return {}, nil;
end;

(* --------------------------------------------------------- commands *)

(* The expanded command a run in this process where it can be: a
   procedure, a builtin; anything else in a child, waited for. *)
proc runArgs(a: []Ccore.Val): (INT, ERROR);
var def: ^Csyntax.Stmt; nm: Ccore.Val; bi, pid: INT;
begin
    if LEN(a) = 0 then return 0, nil; end;
    nm := Ccore.toStr(a[0]);
    def := Cvars.findProc(Ccore.bytes(nm));
    if def # nil then
        Cvars.setStatus(0);
        _ := try callProc(def, a[1..LEN(a)]);
        return Cvars.status(), nil;
    end;
    bi := cmdBuiltin(nm);
    if bi # 0 then return runCmdBuiltin(bi, a); end;
    correct(a);
    pid := try fork();
    if pid = 0 then
        childJob(0, true);
        execExternal(a);
    end;
    return waitFg(pid, 0, a);
end;

proc isExternal(c: ^Csyntax.Cmd; const st: Stage): BOOL;
begin
    return (c^.call = nil) and (c^.stmt = nil) and extWords(Vals.all(st.args));
end;

(* The command c, expanded into st, run in this process: its status. *)
proc inProc(c: ^Csyntax.Cmd; var st: Stage): (INT, ERROR);
begin
    if c^.stmt # nil then
        try execStmt(c^.stmt);
        return Cvars.status(), nil;
    end;
    if c^.call # nil then
        _ := try eval(c^.call);
        return Cvars.status(), nil;
    end;
    return runArgs(Vals.all(st.args));
end;

(* A pipeline of one command; tail if it may exec over the shell. *)
proc runSingle(c: ^Csyntax.Cmd; tail: BOOL): (INT, ERROR);
var st: Stage; pid, lvl, r: INT; ok: BOOL; err: ERROR;
begin
    if (c^.call = nil) and (c^.stmt = nil) then subSt := ADR(st); end;
    try expand(c, st);
    if isExternal(c, st) then
        if tail then
            ok := try redirect(st.rx, false);
            if not ok then Sys.exit(1); end;
            execExternal(Vals.all(st.args));
        end;
        correct(Vals.all(st.args));
        pid := try fork();
        if pid = 0 then
            childJob(subPg, true);
            ok := try redirect(st.rx, false);
            if not ok then Sys.exit(1); end;
            execExternal(Vals.all(st.args));
        end;
        return waitFg(pid, subPg, Vals.all(st.args));
    end;
    lvl := nsave;
    r := 1;
    ok, err := redirect(st.rx, true);
    if ok and (err = nil) then r, err := inProc(c, st); end;
    if keepFds and (err = nil) then commitFds(lvl); else restoreFds(lvl); end;
    keepFds := false;
    return r, err;
end;

(* A pipeline of several commands, each in a child. *)
proc runMulti(cmds: []^Csyntax.Cmd): (INT, ERROR);
var
    sv: Stages.Vec; pv: Ints.Vec; sts: []Stage; pids: []INT; b: Buf.Buf;
    n, i, st, r, w, prev, pg, res: INT; pf, ok: BOOL;
begin
    n := LEN(cmds);
    Stages.init(sv, Ccore.temps);
    Stages.resize(sv, n);
    sts := Stages.all(sv);
    Ints.init(pv, Ccore.temps);
    Ints.resize(pv, n);
    pids := Ints.all(pv);
    for i := 0 to n - 1 do try expand(cmds[i], sts[i]); end;
    prev := -1;
    pg := subPg;    (* the job's group: a <(...)'s, or the first stage's *)
    for i := 0 to n - 1 do
        if isExternal(cmds[i], sts[i]) then correct(Vals.all(sts[i].args)); end;
        if i < n - 1 then
            r, w := Sys.pipe();
            if r < 0 then return 0, Ccore.fail("cannot make pipe"); end;
        end;
        pids[i] := try fork();
        if pids[i] = 0 then
            childJob(pg, true);
            if prev >= 0 then
                _ := Sys.dupTo(prev, 0);
                Sys.close(prev);
            end;
            if i < n - 1 then
                Sys.close(r);
                _ := Sys.dupTo(w, 1);
                Sys.close(w);
            end;
            ok := try redirect(sts[i].rx, false);
            if not ok then Sys.exit(1); end;
            if isExternal(cmds[i], sts[i]) then execExternal(Vals.all(sts[i].args)); end;
            st, _ := inProc(cmds[i], sts[i]);
            Sys.exit(st);
        end;
        joinGroup(pids[i], pg, true);
        if pg = 0 then pg := pids[i]; end;
        if prev >= 0 then Sys.close(prev); end;
        if i < n - 1 then
            Sys.close(w);
            prev := r;
        end;
    end;
    if jc then
        Buf.init(b, Ccore.temps);
        for i := 0 to n - 1 do
            if i > 0 then Buf.str(b, " | "); end;
            argsName(Vals.all(sts[i].args), b);
        end;
        return foreground(pids, pg, Buf.bytes(b));
    end;
    pf := Cvars.flag("pipefail");
    intSeen := false;
    for i := 0 to n - 1 do
        if i = n - 1 then intr := intr or intSeen; end;    (* the last stage decides *)
        st := waitFor(pids[i]);
        if not pf or (st # 0) then res := st; end;
    end;
    return res, nil;
end;

(* A pipeline, single or not. A command run while another's words
   expand, in $(f()), has <(...)s of its own, aside from the other's. *)
proc runPipe(p: Csyntax.Pipe): (INT, ERROR);
var tail, sAll: BOOL; lvl, sPg, r: INT; sSt: ^Stage; err: ERROR;
begin
    tail := tailOk;
    tailOk := false;
    lvl := nsub;
    sPg := subPg;
    sSt := subSt;
    sAll := subAll;
    subPg := 0;
    subSt := nil;
    subAll := LEN(p.cmds) > 1;
    if LEN(p.cmds) = 1 then r, err := runSingle(p.cmds[0], tail); else r, err := runMulti(p.cmds); end;
    closeSubs(lvl);
    subPg := sPg;
    subSt := sSt;
    subAll := sAll;
    if err # nil then return 0, err; end;
    Cvars.setStatus(r);
    return r, nil;
end;

(* a && b || c: all but the last pipeline exempt from errexit. *)
proc runChain(pipes: []Csyntax.Pipe): (INT, ERROR);
var r, i: INT; ran: BOOL; err: ERROR;
begin
    ran := true;
    for i := 0 to LEN(pipes) - 1 do
        if i > 0 then ran := (pipes[i - 1].join = Csyntax.jAnd) = (r = 0); end;
        if ran then
            if i < LEN(pipes) - 1 then INC(exempt); end;
            r, err := runPipe(pipes[i]);
            if i < LEN(pipes) - 1 then DEC(exempt); end;
            if err # nil then return 0, err; end;
        end;
    end;
    chainSkipped := not ran;
    return r, nil;
end;

(* A background list's name: its words as written, for they are
   expanded only in the job. *)
proc listName(pipes: []Csyntax.Pipe; var b: Buf.Buf);
var c: ^Csyntax.Cmd; i, j, k, m: INT;
begin
    for i := 0 to LEN(pipes) - 1 do
        for j := 0 to LEN(pipes[i].cmds) - 1 do
            c := pipes[i].cmds[j];
            if (LEN(c^.words) = 0) or (c^.call # nil) then Buf.str(b, "..."); end;
            for k := 0 to LEN(c^.words) - 1 do
                for m := 0 to LEN(c^.words[k]) - 1 do
                    match c^.words[k][m].kind of
                    | ptLit: Buf.str(b, c^.words[k][m].s);
                    | ptVar:
                        Buf.add(b, '$');
                        Buf.str(b, c^.words[k][m].s);
                    | ptHome:
                        Buf.add(b, '~');
                        Buf.str(b, c^.words[k][m].s);
                    | else: Buf.str(b, "...");
                    end;
                end;
                if k < LEN(c^.words) - 1 then Buf.add(b, ' '); end;
            end;
            if j < LEN(pipes[i].cmds) - 1 then Buf.str(b, " | "); end;
        end;
        if i < LEN(pipes) - 1 then
            if pipes[i].join = Csyntax.jAnd then Buf.str(b, " && "); else Buf.str(b, " || "); end;
        end;
    end;
end;

(* A command statement. One run with & is a process group of its own,
   led by the shell that runs it, so that a signal sent to that shell
   reaches the whole list: killing lastpid stops every stage of a
   pipeline. Under job control it is a job, which may read the terminal
   (and stop) and takes Ctrl-C when brought to the foreground; without,
   it reads /dev/null and ignores Ctrl-C. SIGINT and SIGQUIT are left
   alone: the terminal sends them to the group already, or they are
   ignored. *)
proc runAndOr(s: ^Csyntax.Stmt): (INT, ERROR);
var b: Buf.Buf; pids: [1]INT; pid, fd, i, k: INT; own: BOOL;
begin
    if not s^.bg then return runChain(s^.pipes); end;
    own := jc;
    pid := try fork();
    if pid = 0 then
        childJob(0, false);
        _ := Sys.setGroup(0, 0);
        for i := 1 to NTrap - 1 do
            if (TrapSigs[i] = Sys.sigInt) or (TrapSigs[i] = Sys.sigQuit) then
                if not own then setSig(i, dIgnore); end;
            elsif traps[i].act # aIgnore then
                setSig(i, dPassOn);
            end;
        end;
        if not own then
            fd := Sys.openRead("/dev/null");
            if fd >= 0 then _ := place(fd, 0, false); end;
        end;
        tailOk := LEN(s^.pipes) = 1;
        k, _ := runChain(s^.pipes);
        Sys.exit(k);
    end;
    _ := Sys.setGroup(pid, pid);
    Buf.init(b, Ccore.temps);
    listName(s^.pipes, b);
    pids[0] := pid;
    k := newJob(pids, pid, Buf.bytes(b));
    if interactive then report(k, Ccore.text("{}", [Fmt.int(pid)])); end;
    try Cvars.store(Cvars.global("lastpid"), Ccore.intVal(pid));
    return 0, nil;
end;

(* At the prompt: the jobs that finished or stopped since, said. *)
proc reapJobs*;
var e: Ended; j: ^Job; pid, k: INT;
begin
    while true do
        pid, e.how, e.n := Sys.wait(-1, false);
        if pid <= 0 then break; end;
        if e.how = Sys.stopped then
            k := findJob(pid);
            if (k >= 0) and not Jobs.all(jobs)[k].stopped then
                Jobs.all(jobs)[k].stopped := true;
                report(makeCurrent(k), "stopped");
            end;
        else
            k := reaped(pid, e);
            if k >= 0 then
                j := ADR(Jobs.all(jobs)[k]);
                if j^.left = 0 then
                    if j^.ends[LEN(j^.ends) - 1].how = Sys.killed then
                        report(k, "killed");
                    else
                        report(k, Ccore.text("done {}", [Fmt.int(jobStatus(k))]));
                    end;
                    dropJob(k);
                end;
            end;
        end;
    end;
end;

(* ------------------------------------------------------- statements *)

(* x[i] := v: a list's ith item, from 0, or a string's ith byte, from 1,
   which v must be one of. *)
proc setIndex(s: ^Csyntax.Stmt; v: Ccore.Val): ERROR;
var i: I64; r: ^Cvars.Var; k: Ccore.Val; it: []Ccore.Val;
begin
    i := try Ccore.toInt(try eval(s^.e2));
    r := Cvars.find(s^.s);
    if r = nil then return Cvars.undefined(s^.s); end;
    match r^.v.kind of
    | kList:
        if (i < 0) or (i >= r^.v.n) then return Ccore.fail("index out of range"); end;
        it := Ccore.items(r^.v);
        k := Ccore.keep(v);
        Ccore.drop(it[i]);
        it[i] := k;
    | kStr:
        k := Ccore.toStr(v);
        if (i < 1) or (i > r^.v.n) or (k.n # 1) then return Ccore.fail("bad string index assignment"); end;
        Ccore.bytes(r^.v)[i - 1] := Ccore.bytes(k)[0];
    | else: return Ccore.fail(Ccore.text("cannot index {}", [Fmt.str(Ccore.kindName(r^.v.kind))]));
    end;
    return nil;
end;

(* After a loop's body: does the loop end? A break ends it and is done
   with; a continue is done with; an exit ends it and goes on out. *)
proc loopDone: BOOL;
begin
    if ctl = cBreak then
        ctl := cNone;
        return true;
    end;
    if ctl = cCont then ctl := cNone; end;
    return ctl # cNone;
end;

(* A loop's condition, its temporaries given back. *)
proc test(e: ^Csyntax.Expr): (BOOL, ERROR);
var m: Ccore.Mark; b: BOOL;
begin
    m := Ccore.mark();
    b := try Ccore.truth(try eval(e));
    Ccore.release(m);
    return b, nil;
end;

proc execList(l: []^Csyntax.Stmt): ERROR;
var i: INT;
begin
    i := 0;
    while (i < LEN(l)) and (ctl = cNone) do
        try execStmt(l[i]);
        INC(i);
    end;
    return nil;
end;

proc execCase(s: ^Csyntax.Stmt): ERROR;
var v: Ccore.Val; i, j: INT;
begin
    v := try eval(s^.e);
    for i := 0 to LEN(s^.arms) - 1 do
        for j := 0 to LEN(s^.arms[i].labels) - 1 do
            if try matches(v, s^.arms[i].labels[j]) then return execStmt(s^.arms[i].body); end;
        end;
    end;
    if s^.els # nil then return execStmt(s^.els); end;
    return nil;
end;

proc execFor(s: ^Csyntax.Stmt): ERROR;
var i, hi: I64;
begin
    i := try Ccore.toInt(try eval(s^.e));
    hi := try Ccore.toInt(try eval(s^.e2));
    while not s^.down and (i <= hi) or s^.down and (i >= hi) do
        try Cvars.assign(s^.s, Ccore.intVal(i));
        try execStmt(s^.body);
        if loopDone() then break; end;
        if i = hi then break; end;    (* never past the largest integer *)
        if s^.down then DEC(i); else INC(i); end;
    end;
    return nil;
end;

proc execForIn(s: ^Csyntax.Stmt): ERROR;
var v: Ccore.Val; it: []Ccore.Val; i: INT;
begin
    v := try eval(s^.e);
    if v.kind # Ccore.kList then
        return Ccore.fail(Ccore.text("for-in needs a list, got {}; try lines() or split()", [Fmt.str(Ccore.kindName(v.kind))]));
    end;
    it := Ccore.items(v);
    for i := 0 to LEN(it) - 1 do
        try Cvars.assign(s^.s, it[i]);
        try execStmt(s^.body);
        if loopDone() then break; end;
    end;
    return nil;
end;

proc execExport(s: ^Csyntax.Stmt): ERROR;
var r: ^Cvars.Var; v: Ccore.Val;
begin
    r := Cvars.findGlobal(s^.s);
    if s^.e # nil then
        v := try eval(s^.e);
        r := Cvars.global(s^.s);
        try Cvars.store(r, v);
    elsif r = nil then
        r := Cvars.global(s^.s);
        try Cvars.store(r, {kind: Ccore.kStr});
    end;
    r^.exported := true;
    return nil;
end;

(* exit, or exit(e): in a function e is the result, elsewhere the
   status. *)
proc execExit(s: ^Csyntax.Stmt): ERROR;
var v: Ccore.Val;
begin
    if s^.e # nil then
        v := try eval(s^.e);
        if (curFunc # nil) and curFunc^.isFunc then
            try Cvars.assign("result", v);
        else
            Cvars.setStatus(INT(I32(try Ccore.toInt(v))));
        end;
    end;
    ctl := cExit;
    return nil;
end;

(* errexit: the end of the script, or of the line at the prompt, with
   the status. *)
proc errExit: ERROR;
begin
    if Ccore.opts^.inChild then Sys.exit(Cvars.status()); end;
    return Ccore.ErrExit;
end;

proc execStmt(s: ^Csyntax.Stmt): ERROR;
var m: Ccore.Mark; v: Ccore.Val; st: INT;
begin
    noteSignals;
    if intr then return interrupted(); end;
    if trapPending then try runTraps(); end;
    Ccore.where^.line := s^.line;
    Ccore.where^.file := s^.path;
    m := Ccore.mark();
    defer Ccore.release(m);
    match s^.kind of
    | sCmd:
        st := try runAndOr(s);
        if (st # 0) and (exempt = 0) and not chainSkipped and Cvars.flag("errexit") then return errExit(); end;
    | sAssign:
        v := try eval(s^.e);
        if s^.e2 = nil then try Cvars.assign(s^.s, v); else try setIndex(s, v); end;
    | sIf:
        if try Ccore.truth(try eval(s^.e)) then
            try execStmt(s^.body);
        elsif s^.els # nil then
            try execStmt(s^.els);
        end;
    | sWhile:
        while true do    (* the test inside: see RAZ-NOTES.md, "The compiler" *)
            if not try test(s^.e) then break; end;
            try execStmt(s^.body);
            if loopDone() then break; end;
        end;
    | sRepeat:
        while true do
            try execStmt(s^.body);
            if loopDone() or try test(s^.e) then break; end;
        end;
    | sFor: try execFor(s);
    | sForIn: try execForIn(s);
    | sCase: try execCase(s);
    | sBlock: try execList(s^.list);
    | sVar:
        if s^.e # nil then v := try eval(s^.e); end;
        try Cvars.declare(s^.s, v);
    | sExport: try execExport(s);
    | sProc: Cvars.defineProc(s);
    | sBreak: ctl := cBreak;
    | sContinue: ctl := cCont;
    | sExit: try execExit(s);
    end;
    return nil;
end;

(* ---------------------------------------------------------- running *)

(* The program text, from the file path ("" if none), parsed and run. *)
proc runText*(text, path: []U8): ERROR;
begin
    return execList(try Csyntax.parse(text, path));
end;

(* After an error: the shell as it is between statements. *)
proc recover*;
begin
    restoreFds(0);
    closeSubs(0);
    Cvars.leave({});
    curFunc := nil;
    ctl := cNone;
    tailOk := false;
    keepFds := false;
    exempt := 0;
    inPromptProc := false;
    intr := false;
end;

(* A line typed at the prompt, parsed and run; More, with nothing
   written, if it ends before what it opens does. *)
proc runTyped*(text: []U8): ERROR;
begin
    return execList(try Csyntax.parseTyped(text));
end;

(* -------------------------------------------- completion, editing *)

(* The user's function complete, asked what the word p might become
   after words: it gets them all as one list, the last being p, and
   answers with a list of words or a string of lines, which go into
   ans. It runs with every standard fd on /dev/null, an error in it
   counts as no answer, and status is left as it was. *)
proc ask(p: []U8; words: []Ccore.Val; var ans: Vals.Vec);
var
    def, up: ^Csyntax.Stmt; all: Vals.Vec; one: [1]Ccore.Val; r: Ccore.Val; f: Cvars.Frame; s: []U8;
    st, lvl, ns, ex, fd, i, j: INT; err: ERROR;
begin
    def := Cvars.findProc("complete");
    if (def = nil) or not def^.isFunc then return; end;
    Vals.init(all, Ccore.temps);
    for i := 0 to LEN(words) - 1 do Vals.push(all, words[i]); end;
    Vals.push(all, Ccore.strVal(p));
    one[0] := Ccore.listVal(all);
    st := Cvars.status();
    lvl := nsave;
    ns := nsub;
    f := Cvars.here();
    up := curFunc;
    ex := exempt;
    fd := Sys.open("/dev/null", {Sys.reading, Sys.writing});
    if fd >= 0 then
        for i := 0 to 2 do
            if err = nil then err := saveFd(i); end;
            _ := Sys.dupTo(fd, i);
        end;
        Sys.close(fd);
        if err = nil then r, err := callProc(def, one); end;
        if err # nil then
            r := {};
            closeSubs(ns);
            Cvars.leave(f);
            curFunc := up;
            exempt := ex;
            ctl := cNone;
            tailOk := false;
            keepFds := false;
            intr := false;
        end;
    end;
    restoreFds(lvl);
    Cvars.setStatus(st);
    if r.kind = Ccore.kList then
        for i := 0 to INT(r.n) - 1 do Vals.push(ans, Ccore.toStr(Ccore.items(r)[i])); end;
    elsif r.kind = Ccore.kStr then
        s := Ccore.bytes(r);
        i := 0;
        while i < LEN(s) do
            j := i;
            while (j < LEN(s)) and (s[j] # '\n') do INC(j); end;
            if j > i then Vals.push(ans, Ccore.strVal(s[i..j])); end;
            i := j + 1;
        end;
    end;
end;

(* For the line editor's Tab: what the unquoted word p might become in
   the context cx, after the command's words, added to out; true if out
   is ranked. *)
proc complete*(p: []U8; cx: Cedit.Context; words: []Ccore.Val; var out: Vals.Vec): BOOL;
begin
    return Ccomplete.complete(p, cx, words, out, ask);
end;

(* An external command typed at the prompt that won't be found: the
   child is to say "did you mean", and the line fixed that way is
   offered as the next line's suggestion. *)
proc correct(a: []Ccore.Val);
var nm, fix: []U8;
begin
    if not interactive or (Cvars.depth > 0) or (LEN(a) = 0) then return; end;
    nm := Ccore.bytes(Ccore.toStr(a[0]));
    if (Str.find(nm, "/") >= 0) or Ccomplete.knownCommand(nm) then return; end;
    fix := Ccomplete.suggestCommand(nm);
    if LEN(fix) > 0 then Cedit.propose(nm, fix); end;
end;

(* For the line editor's ctrl-x ctrl-e: $VISUAL, or $EDITOR, or vi, run
   on the file path as a command in the foreground. The editor may be a
   procedure, and may carry options after blanks, as in "emacs -nw".
   status is left as it was; an error, written already, is the edit's
   end, the line taken as the file holds it. *)
proc editFile*(path: []U8);
var a: Vals.Vec; e: []U8; m: Ccore.Mark; st, i, j: INT;
begin
    m := Ccore.mark();
    st := Cvars.status();
    e := Cvars.str("VISUAL");
    if LEN(e) = 0 then e := Cvars.str("EDITOR"); end;
    if LEN(e) = 0 then e := "vi"; end;
    Vals.init(a, Ccore.temps);
    i := 0;
    while i < LEN(e) do
        while (i < LEN(e)) and ((e[i] = ' ') or (e[i] = '\t')) do INC(i); end;
        j := i;
        while (j < LEN(e)) and (e[j] # ' ') and (e[j] # '\t') do INC(j); end;
        if j > i then Vals.push(a, Ccore.strVal(e[i..j])); end;
        i := j;
    end;
    Vals.push(a, Ccore.strVal(path));
    _, _ := runArgs(Vals.all(a));
    Cvars.setStatus(st);
    Ccore.release(m);
end;

(* ------------------------------------------------------------ setup *)

(* The shell's globals at its start: the environment, PWD, the
   switches, lastpid, pid and status. *)
proc initShell*;
var r: ^Cvars.Var; d: []U8; e: INT;
begin
    Cvars.importEnv;
    d, e := Sys.workDir();
    if e = 0 then
        r := Cvars.global("PWD");
        _ := Cvars.store(r, Ccore.strVal(d));
        r^.exported := true;
    end;
    _ := Cvars.store(Cvars.global("errexit"), Ccore.boolVal(false));
    _ := Cvars.store(Cvars.global("lastpid"), Ccore.intVal(0));
    _ := Cvars.store(Cvars.global("pipefail"), Ccore.boolVal(false));
    r := Cvars.global("pid");
    _ := Cvars.store(r, Ccore.intVal(Sys.pid()));
    r^.exported := false;
    r^.readOnly := true;
    Cvars.setStatus(0);
end;

(* The shell reads its commands at a prompt: a message gives no line
   number, and a command not found suggests a fix. *)
proc setInteractive*;
begin
    interactive := true;
    Ccore.opts^.showLine := false;
end;

(* Did a Ctrl-C stop what ran since the last call? *)
proc takeIntr*: BOOL;
var was: BOOL;
begin
    was := intr;
    intr := false;
    return was;
end;

(* The prompt, on standard error: ". " for a line that goes on; else
   the user's procedure prompt, if custom and there is one; else the
   last part of PWD and "> ". *)
proc prompt*(more, custom: BOOL): ERROR;
var def: ^Csyntax.Stmt; cwd: []U8; i: INT;
begin
    if more then
        Ccore.put(2, ". ");
        return nil;
    end;
    def := Cvars.findProc("prompt");
    if custom and (def # nil) then
        inPromptProc := true;
        _ := try callProc(def, []);
        inPromptProc := false;
        return nil;
    end;
    cwd := Cvars.str("PWD");
    i := LEN(cwd);
    while (i > 0) and (cwd[i - 1] # '/') do DEC(i); end;
    if LEN(cwd) > 1 then Ccore.put(2, cwd[i..LEN(cwd)]); else Ccore.put(2, cwd); end;
    Ccore.put(2, "> ");
    return nil;
end;

(* args: the command line's arguments from first on. *)
proc setArgs*(first: INT);
var out: Vals.Vec; m: Ccore.Mark; i: INT;
begin
    m := Ccore.mark();
    Vals.init(out, Ccore.temps);
    for i := first to ARGC() - 1 do Vals.push(out, Ccore.strVal(Files.arg(i))); end;
    _ := Cvars.store(Cvars.global("args"), Ccore.listVal(out));
    Ccore.release(m);
end;

begin
    Jobs.init(jobs, Heap.heap);
end Cinterp.
