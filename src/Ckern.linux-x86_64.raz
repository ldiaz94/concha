(* Ckern: the system calls concha makes that Sys doesn't.

   A shell starts its programs itself, where Sys.spawn can't follow:
   it forks, sets up any file descriptor and signal in the child, and
   execs; a stage of a pipe that is a procedure runs in the forked
   shell and never execs at all. So this module has fork, exec and
   dup2, a copy of a descriptor above the ones a user redirects, a
   signal's handler, the terminal's settings, the process group, the
   umask, resource limits, access and wait4 with its options. What Sys
   has (the terminal's size and foreground, setpgid, chdir, getcwd, the
   time, pipes, kill, ignoring a signal) is used from Sys.

   Each is a SYSCALL with Linux's number on x86-64, and each structure
   is laid out as the kernel reads it there. Like Sys, a call answers
   0 or a count when it worked, and minus an errno when it failed. *)
module Ckern;
import Sys;
link static;

const
    (* the errors concha names, by Linux's numbers *)
    errPerm* = 1;
    errNoEnt* = 2;
    errIntr* = 4;
    errNoExec* = 8;
    errChild* = 10;
    errAcces* = 13;
    errExist* = 17;
    errNotDir* = 20;
    errIsDir* = 21;
    errInval* = 22;
    errMFile* = 24;
    errNameTooLong* = 36;
    errLoop* = 40;

    (* wait's options: return at once when no child has changed; report
       a child that stopped, too *)
    noHang* = 1;
    untraced* = 2;

    (* the bits of Termios concha changes *)
    tiBrkInt* = 2H;
    tiInPck* = 10H;
    tiIStrip* = 20H;
    tiICrNl* = 100H;
    tiIXon* = 400H;
    tcCs8* = 30H;
    tlISig* = 1H;
    tlICanon* = 2H;
    tlEcho* = 8H;
    tlIExten* = 8000H;
    (* the bytes of cc a raw read waits by *)
    ccTime* = 5;
    ccMin* = 6;

    (* the permissions a new file asks for, before the umask: rw------- and
       rw-rw-rw- (octal 600 and 666) *)
    permOwn* = 180H;
    permAll* = 1B6H;

    (* access's question: may it be run? *)
    canRun* = 1;

    (* the resources of limit and setLimit, and a limit that is none *)
    rlCpu* = 0;
    rlFSize* = 1;
    rlStack* = 3;
    rlCore* = 4;
    rlNoFile* = 7;
    rlAs* = 9;
    rlInfinity* = -1;

    PathMax = 4096;    (* PATH_MAX, its zero included *)

type
    (* struct termios, as TCGETS fills it *)
    Termios* = record
        iflag*, oflag*, cflag*, lflag*: U32;
        line*: U8;
        cc*: [19]U8;
    end;

    (* What runs when a signal comes, given its number. It runs between
       any two instructions of the program, so it only sets a flag, with
       XCHG, or does what it must and ends the program. *)
    Handler* = proc(sig: INT);

    (* struct sigaction, as rt_sigaction reads it *)
    Action = record
        handler: Handler;
        flags: U64;
        restorer: proc;
        mask: U64;
    end;

(* The terminal's settings on fd, read and set at once. *)
proc termGet*(fd: INT; var t: Termios): INT;
begin
    return SYSCALL(16, fd, 5401H, ADR(t));      (* ioctl TCGETS *)
end;

proc termSet*(fd: INT; t: Termios): INT;
begin
    return SYSCALL(16, fd, 5402H, ADR(t));      (* ioctl TCSETS *)
end;

(* The process group this process is in. *)
proc group*: INT;
begin
    return SYSCALL(121, 0);                     (* getpgid *)
end;

(* fd copied onto new, which is closed first if open. *)
proc dup2*(fd, new: INT): INT;
begin
    return SYSCALL(33, fd, new);
end;

(* A copy of fd at the lowest free descriptor from least on, closed
   when the shell execs: where a redirected descriptor is kept to be
   put back. *)
proc dupAbove*(fd, least: INT): INT;
begin
    return SYSCALL(72, fd, 1030, least);        (* fcntl F_DUPFD_CLOEXEC *)
end;

(* This process copied: 0 in the child, the child's id in the parent.
   Whatever a buffer holds is copied too, and written twice if both
   write it, so the shell writes its output unbuffered. *)
proc fork*: INT;
begin
    return SYSCALL(57);
end;

(* s with a zero after it, at p: the byte after the zero. *)
proc put(s: []U8; p: ^U8): ^U8;
var i: INT;
begin
    for i := 0 to LEN(s) - 1 do p[i] := s[i]; end;
    p[LEN(s)] := 0;
    return p + (LEN(s) + 1);
end;

(* The program at path run in place of this process, with args, the
   first its name, and env, each NAME=value, as its whole environment.
   It answers only if it failed: minus an errno. *)
proc exec*(path: []U8; args, env: [][]U8): INT;
var mem, p: ^U8; v: ^^U8; size, i, r: INT;
begin
    (* the pointers, each list ended by nil, then the strings *)
    size := (LEN(args) + LEN(env) + 2) * SIZE(^U8) + LEN(path) + 1;
    for i := 0 to LEN(args) - 1 do INC(size, LEN(args[i]) + 1); end;
    for i := 0 to LEN(env) - 1 do INC(size, LEN(env[i]) + 1); end;
    mem := Sys.mmap(size);
    if mem = nil then return -12; end;          (* ENOMEM *)
    v := ^^U8(mem);
    p := mem + (LEN(args) + LEN(env) + 2) * SIZE(^U8);
    for i := 0 to LEN(args) - 1 do v[i] := p; p := put(args[i], p); end;
    v[LEN(args)] := nil;
    for i := 0 to LEN(env) - 1 do v[LEN(args) + 1 + i] := p; p := put(env[i], p); end;
    v[LEN(args) + 1 + LEN(env)] := nil;
    _ := put(path, p);
    r := SYSCALL(59, p, v, v + (LEN(args) + 1));    (* execve *)
    Sys.munmap(mem, size);
    return r;
end;

proc sigReturn;
code
    mov eax, 15;
    syscall;
end sigReturn;

(* h run when the signal sig comes, or what sig does at first if h is
   nil. A system call it breaks into fails with -4 (EINTR) rather than
   going on, so that a shell waiting for a program, or for a key, sees
   Ctrl-C. Sys.ignore ignores a signal. *)
proc handle*(sig: INT; h: Handler): INT;
var act: Action;
begin
    act := {handler: h};
    if h # nil then act.flags := 4000000H; act.restorer := sigReturn; end;   (* SA_RESTORER *)
    return SYSCALL(13, sig, ADR(act), 0, 8);    (* rt_sigaction *)
end;

(* Sets the umask, and answers the one before. *)
proc umask*(mask: INT): INT;
begin
    return SYSCALL(95, mask);
end;

(* The soft limit of resource r, rlInfinity for none. *)
proc limit*(r: INT): (I64, INT);
var l: [2]I64;    (* struct rlimit64: the soft limit, the hard *)
    e: INT;
begin
    e := SYSCALL(302, 0, r, 0, ADR(l));         (* prlimit64 *)
    return l[0], e;
end;

(* The soft limit of resource r set to lim. *)
proc setLimit*(r: INT; lim: I64): INT;
var l: [2]I64; e: INT;
begin
    e := SYSCALL(302, 0, r, 0, ADR(l));
    if e # 0 then return e; end;
    l[0] := lim;
    return SYSCALL(302, 0, r, ADR(l), 0);
end;

(* 0 if this process may do what mode asks of path: canRun, say. *)
proc access*(path: []U8; mode: INT): INT;
var a: [PathMax]U8;
begin
    if LEN(path) >= PathMax then return -errNameTooLong; end;
    _ := put(path, ADR(a[0]));
    return SYSCALL(269, -100, ADR(a), mode, 0); (* faccessat, AT_FDCWD *)
end;

(* Waits for the child pid, or any child if -1, or any of the group -g,
   to change, as options say, and tells which one changed and how, as
   Sys.wait does: exited with its status, or killed or stopped by a
   signal. With noHang, 0 and running if none has changed. *)
proc wait*(pid, options: INT): (INT, Sys.Status, INT);
var status: I32; r: INT;
begin
    r := SYSCALL(61, pid, ADR(status), options, 0);   (* wait4 *)
    if r <= 0 then return r, Sys.running, 0; end;
    if status & 7FH = 0 then return r, Sys.exited, INT(status) shr 8 & 0FFH; end;
    if status & 0FFH = 7FH then return r, Sys.stopped, INT(status) shr 8 & 0FFH; end;
    return r, Sys.killed, INT(status) & 7FH;
end;

end Ckern.
