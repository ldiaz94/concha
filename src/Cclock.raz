(* Cclock: an instant as text, for time(): a small strftime.

   The date and time are the local clock's, from rzone's Zone, which
   reads the zone TZ names as the C library does and works out the
   date the clock shows, its offset and its abbreviation. Instants
   before 1970 count too.

   Depends on Ccore for the arena and errors, and on Zone for the
   clock. Left out: the locale; names are English. *)
module Cclock;
import Buf, Str, Fmt, Ccore, Zone;

const
    DayNames: [][]const U8 = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    MonthNames: [][]const U8 = [
        "January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
        "November", "December"
    ];

(* v in decimal added to b, at least w digits wide, padded with pad. *)
proc num(var b: Buf.Buf; v: I64; w: INT; pad: U8);
var d: [20]U8; k: INT;
begin
    d, k := Str.fromInt(v);
    while w > k do
        Buf.add(b, pad);
        DEC(w);
    end;
    Buf.str(b, d[0..k]);
end;

(* fmt with the instant ms, milliseconds since 1970, in the local time
   zone, in the arena. *)
proc format*(fmt: []const U8; ms: I64): ([]const U8, ERROR);
var b: Buf.Buf; tm: Zone.Time; secs: I64; i, off: INT; c: U8;
begin
    (* whole seconds, rounded down, so that -1 ms is 23:59:59 the day before *)
    secs := ms div 1000;
    if ms mod 1000 < 0 then DEC(secs); end;
    tm := Zone.local(secs);
    Buf.init(b, Ccore.temps);
    i := 0;
    while i < LEN(fmt) do
        c := fmt[i];
        INC(i);
        if c # '%' then
            Buf.add(b, c);
            continue;
        end;
        if i = LEN(fmt) then return "", Ccore.fail("time format ends in %"); end;
        c := fmt[i];
        INC(i);
        match c of
        | 'Y': num(b, tm.year, 4, '0');
        | 'y': num(b, tm.year mod 100, 2, '0');
        | 'm': num(b, tm.month, 2, '0');
        | 'd': num(b, tm.day, 2, '0');
        | 'e': num(b, tm.day, 2, ' ');
        | 'H': num(b, tm.hour, 2, '0');
        | 'M': num(b, tm.minute, 2, '0');
        | 'S': num(b, tm.second, 2, '0');
        | 'a': Buf.str(b, DayNames[tm.weekday][0..3]);
        | 'A': Buf.str(b, DayNames[tm.weekday]);
        | 'b': Buf.str(b, MonthNames[tm.month - 1][0..3]);
        | 'B': Buf.str(b, MonthNames[tm.month - 1]);
        | 's': num(b, secs, 1, '0');
        | 'z':
            off := tm.offset div 60;
            if off < 0 then
                Buf.add(b, '-');
                off := -off;
            else
                Buf.add(b, '+');
            end;
            num(b, off div 60, 2, '0');
            num(b, off mod 60, 2, '0');
        | 'Z': Buf.str(b, tm.abbr);
        | 'F':
            num(b, tm.year, 4, '0');
            Buf.add(b, '-');
            num(b, tm.month, 2, '0');
            Buf.add(b, '-');
            num(b, tm.day, 2, '0');
        | 'T', 'R':
            num(b, tm.hour, 2, '0');
            Buf.add(b, ':');
            num(b, tm.minute, 2, '0');
            if c = 'T' then
                Buf.add(b, ':');
                num(b, tm.second, 2, '0');
            end;
        | '%': Buf.add(b, '%');
        | else: return "", Ccore.fail(Ccore.text("unknown time format %{}", [Fmt.char(c)]));
        end;
    end;
    return Buf.bytes(b), nil;
end;

end Cclock.
